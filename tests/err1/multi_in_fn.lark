// 期望错误：同一个函数里的几处错误一起报出来（跳过报过错的那条语句再检查）。
// 声明新变量的语句出错时：带类型标注的照标注声明，后面照常检查；不带标注的，块里后面的语句不再检查（免得每处用到它都报一次）。
// 错误在跨行表达式中间的一行时，跳过整个函数体，接着检查后面的函数
fn g(x: int, y: int) -> int { x + y }

fn h() -> int {
    g(1,
        qqqq)
}

fn main() {
    a: int = "x"
    print("#{a + 1}#{cccc}")
    if a > 0 {
        print("#{dddd}")
    }
    b = eeee
    print("#{b}#{ffff}")
    print("#{h()}")
}
