a/b.tar.gz：base b.tar.gz，dir a，ext ".gz"，stem b.tar
a/b/：base b，dir a，ext ""，stem b
b.txt：base b.txt，dir .，ext ".txt"，stem b
/b：base b，dir /，ext ""，stem b
.bashrc：base .bashrc，dir .，ext ""，stem .bashrc
根目录：["README.md", "empty", "src"]
  README.md：文件
  empty：目录
  src：目录
