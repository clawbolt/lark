// std/heap 的边界：空堆、重复的元素、字符串，以及和排序的结果逐个比较
import "std/heap"
import "std/rand"
import "std/sort"

test "空堆和重复的元素" {
    h: heap.Heap[int] = heap.new()
    assert(h.is_empty())
    assert_eq(h.peek_min() ?? -1, -1)
    assert_eq(h.pop_min() ?? -1, -1)
    h.insert(3)
    h.insert(3)
    h.insert(1)
    assert_eq(len(h), 3)
    assert_eq(h.peek_min() ?? -1, 1)
    assert(heap.into_sorted(h) == [1, 3, 3])
    s = heap.of(["b", "a", "云", "a"])
    assert_eq(s.pop_min() ?? "", "a")
    assert_eq(s.pop_min() ?? "", "a")
    assert_eq(s.pop_min() ?? "", "b")
    assert_eq(s.pop_min() ?? "", "云")
    assert(s.is_empty())
}

test "和排序的结果一样" {
    r = rand.new(11)
    h: heap.Heap[int] = heap.new()
    all: [int] = []
    for _i in 0..3000 {
        x = r.range(-1000, 1000)
        h.insert(x)
        all.push(x)
    }
    first = sort.sorted(all.copy())
    // 先取出最小的 1000 个，每个都要和排好的对上
    wrong = 0
    for i in 0..1000 {
        if (h.pop_min() ?? 0) != first[i] { wrong += 1 }
    }
    assert_eq(wrong, 0)
    // 再放 1000 个，剩下的全部取出来，和排好的一样
    rest: [int] = []
    for i in 1000..3000 { rest.push(first[i]) }
    for _i in 0..1000 {
        x = r.range(-1000, 1000)
        h.insert(x)
        rest.push(x)
    }
    assert(heap.into_sorted(h) == sort.sorted(rest))
}
