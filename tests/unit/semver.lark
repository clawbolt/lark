// std/semver 的测试：semver.org 第 11 条的排序例子、往返、出错信息的原文、随机版本的往返和比较
import "std/semver"
import "std/rand"
import "std/sort"

test "解析和写出来" {
    v = pv("1.4.0-rc.1+build.5")
    assert_eq(v.major, 1)
    assert_eq(v.minor, 4)
    assert_eq(v.patch, 0)
    assert(v.pre == ["rc", "1"])
    assert(v.build == ["build", "5"])
    assert_eq(semver.format(v), "1.4.0-rc.1+build.5")
    assert_eq("#{v}", "1.4.0-rc.1+build.5")
    for s in ["0.0.0", "10.20.30", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-0.3.7", "1.0.0-x.7.z.92",
              "1.0.0-x-y-z.--", "1.0.0+20130313144700", "1.0.0-beta+exp.sha.5114f85", "1.0.0+21AF26D3----117B344092BD",
              "1.0.0-rc.1-x.0a+b-1", "999999999999999999.0.0"] {
        assert_eq(semver.format(pv(s)), s)
    }
}

test "出错信息" {
    assert_eq(perr(""), "版本号：要写成 主.次.修订，这里是 \"\"")
    assert_eq(perr("1.0"), "版本号：要写成 主.次.修订，这里是 \"1.0\"")
    assert_eq(perr("v1.0.0"), "版本号：主版本号 \"v1\" 不是数字")
    assert_eq(perr("01.0.0"), "版本号：主版本号 \"01\" 有前导零")
    assert_eq(perr("1..0"), "版本号：次版本号是空的")
    assert_eq(perr("1.0.0-"), "版本号：预发布有空的标识符")
    assert_eq(perr("1.0.0-a..b"), "版本号：预发布有空的标识符")
    assert_eq(perr("1.0.0-01"), "版本号：预发布的数字标识符 \"01\" 有前导零")
    assert_eq(perr("1.0.0+"), "版本号：构建信息有空的标识符")
    assert_eq(perr("1.0.0+a_b"), "版本号：构建信息的标识符 \"a_b\" 里只能有 0-9 A-Z a-z -")
    assert_eq(perr("1.0.0+01"), "<成功>")
    assert_eq(perr("1000000000000000000.0.0"), "版本号：主版本号 \"1000000000000000000\" 太大（超过 18 位）")
}

test "规范第 11 条的先后" {
    chain = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11",
             "1.0.0-rc.1", "1.0.0", "2.0.0", "2.1.0", "2.1.1"]
    for i in 0..len(chain) - 1 {
        a = pv(chain[i])
        b = pv(chain[i + 1])
        assert(a < b)
        assert(cmp(b, a) > 0)
    }
    // 构建信息不参与比较，但 == 看所有字段
    a = pv("1.0.0+a")
    b = pv("1.0.0+b")
    assert_eq(cmp(a, b), 0)
    assert(a != b)
    // 数字标识符按数字比，位数多的大
    assert(pv("1.0.0-99999999999999999999") < pv("1.0.0-100000000000000000000"))
    assert(pv("1.0.0-9") < pv("1.0.0-a"))
}

test "随机版本：往返、和排序一致" {
    r = rand.new(3)
    vs: [semver.Version] = []
    wrong = 0
    for _i in 0..500 {
        s = rand_version(&r)
        v = pv(s)
        if semver.format(v) != s { wrong += 1 }
        if cmp(v, v) != 0 { wrong += 1 }
        vs.push(v)
    }
    assert_eq(wrong, 0)
    // 两两比较：交换两边结果反过来；排好以后前后都不倒过来
    for i in 0..50 {
        for j in 0..50 {
            if cmp(vs[i], vs[j]) != -cmp(vs[j], vs[i]) { wrong += 1 }
        }
    }
    sorted = sort.sorted(vs.copy())
    for i in 0..len(sorted) - 1 {
        if cmp(sorted[i], sorted[i + 1]) > 0 { wrong += 1 }
    }
    assert_eq(wrong, 0)
}

// 随机的合法版本，偏向小的数字和容易撞上的标识符
fn rand_version(inout r: rand.Rng) -> str {
    s = "#{r.range(0, 3)}.#{r.range(0, 3)}.#{r.range(0, 3)}"
    ids = ["0", "1", "2", "11", "a", "b", "rc", "alpha", "x-y", "-"]
    n = r.range(0, 4)
    if n > 0 {
        parts: [str] = []
        for _k in 0..n { parts.push(ids[r.range(0, len(ids))].copy()) }
        s += "-" + join(parts, ".")
    }
    if r.range(0, 3) == 0 { s += "+b.#{r.range(0, 100)}" }
    s
}

fn pv(s: str) -> semver.Version {
    match semver.parse(s) {
        Ok(v) => v.copy()
        Err(e) => panic(e)
    }
}

fn perr(s: str) -> str {
    match semver.parse(s) {
        Ok(_) => "<成功>"
        Err(e) => e.copy()
    }
}

test "乱输入只返回错误" {
    // 在合法的版本上随机换、插、删几个字节，再加完全随机的短串：只能返回错误，不能 panic；
    // 能解析的，写出来再解析还是同一个版本
    r = rand.new(9)
    alpha = "0123456789.-+azAZ_v "
    wrong = 0
    for _i in 0..3000 {
        s = rand_version(&r)
        for _k in 0..r.range(0, 4) {
            p = r.range(0, len(s) + 1)
            k = r.range(0, len(alpha))
            ch = if r.range(0, 4) == 0 { from_byte(r.range(0, 256)) } else { slice(alpha, k, k + 1) }
            op = r.range(0, 3)
            if op == 0 { s = slice(s, 0, p) + ch + slice(s, p, len(s)) }
            if op == 1 && p < len(s) { s = slice(s, 0, p) + slice(s, p + 1, len(s)) }
            if op == 2 && p < len(s) { s = slice(s, 0, p) + ch + slice(s, p + 1, len(s)) }
        }
        match semver.parse(s) {
            Ok(v) => {
                if pv(semver.format(v)) != v { wrong += 1 }
            }
            Err(_) => {}
        }
    }
    assert_eq(wrong, 0)
}
