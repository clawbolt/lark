// std/bytes 的测试：大端和小端的字节顺序、只取低位、边界上的值、读回来不变
import "std/bytes"
import "std/digest"

test "字节顺序" {
    out: [u8] = []
    bytes.push_u16_be(&out, 0x0102)
    bytes.push_u16_le(&out, 0x0102)
    bytes.push_u32_be(&out, 0x0A0B_0C0D)
    bytes.push_u32_le(&out, 0x0A0B_0C0D)
    assert_eq(digest.to_hex(out), "010202010a0b0c0d0d0c0b0a")
    assert_eq(bytes.u16_be(out, 0), 0x0102)
    assert_eq(bytes.u16_le(out, 2), 0x0102)
    assert_eq(bytes.u32_be(out, 4), 0x0A0B_0C0D)
    assert_eq(bytes.u32_le(out, 8), 0x0A0B_0C0D)
    // 从中间读：读到的是那 4 个字节
    assert_eq(bytes.u32_be(out, 2), 0x0201_0A0B)
}

test "只取低位、边界上的值" {
    out: [u8] = []
    bytes.push_u16_be(&out, 0x1_FFFF)
    bytes.push_u32_le(&out, -1)
    assert_eq(digest.to_hex(out), "ffffffffffff")
    assert_eq(bytes.u16_be(out, 0), 65535)
    // u32 读出来总是非负的
    assert_eq(bytes.u32_le(out, 2), 0xFFFF_FFFF)
    zero: [u8] = [0, 0, 0, 0]
    assert_eq(bytes.u32_be(zero, 0), 0)
}

test "u64" {
    out: [u8] = []
    bytes.push_u64_be(&out, 0x0102_0304_0506_0708)
    assert_eq(digest.to_hex(out), "0102030405060708")
    assert_eq(bytes.u64_be(out, 0), 0x0102_0304_0506_0708)
    // 最高位是 1 时读出来是负数（int 是有符号的 64 位）
    neg: [u8] = []
    bytes.push_u64_be(&neg, -2)
    assert_eq(digest.to_hex(neg), "fffffffffffffffe")
    assert_eq(bytes.u64_be(neg, 0), -2)
}

fn uv(d: [u8], at: int) -> (int, int) {
    match take bytes.uvarint(d, at) {
        Ok(t) => t
        Err(e) => panic(e)
    }
}

fn uv_err(d: [u8], at: int) -> str {
    match take bytes.uvarint(d, at) {
        Ok(_) => "<成功>"
        Err(e) => e
    }
}

// 和 formal/Lark/Varint.lean 里的例子一样
test "uvarint 写出来再读回去" {
    out: [u8] = []
    bytes.push_uvarint(&out, 300)
    bytes.push_uvarint(&out, 0)
    bytes.push_uvarint(&out, 127)
    bytes.push_uvarint(&out, 128)
    assert_eq(digest.to_hex(out), "ac02007f8001")
    v, n = uv(out, 0)
    assert_eq(v, 300)
    assert_eq(n, 2)
    v2, n2 = uv(out, 2)
    assert_eq(v2, 0)
    assert_eq(n2, 1)
    v3, _ = uv(out, 3)
    assert_eq(v3, 127)
    v4, n4 = uv(out, 4)
    assert_eq(v4, 128)
    assert_eq(n4, 2)
    // -1 是 64 个 1：10 个字节，最后一个是 1
    big: [u8] = []
    bytes.push_uvarint(&big, -1)
    assert_eq(digest.to_hex(big), "ffffffffffffffffff01")
    v5, n5 = uv(big, 0)
    assert_eq(v5, -1)
    assert_eq(n5, 10)
    // 最小的 int：只有最高位是 1
    m: [u8] = []
    bytes.push_uvarint(&m, -9223372036854775807 - 1)
    assert_eq(len(m), 10)
    v6, _ = uv(m, 0)
    assert_eq(v6, -9223372036854775807 - 1)
}

test "uvarint 坏数据返回错误" {
    assert_eq(uv_err([0x80], 0), "varint：数据不完整（读到第 2 个字节时到了结尾）")
    assert_eq(uv_err([], 0), "varint：数据不完整（读到第 1 个字节时到了结尾）")
    over: [u8] = [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x02]
    assert_eq(uv_err(over, 0), "varint：超出 64 位")
    long: [u8] = [0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00]
    assert_eq(uv_err(long, 0), "varint：超出 64 位")
    // 不是最短的写法也接受
    nm: [u8] = [0x80, 0x00]
    v, n = uv(nm, 0)
    assert_eq(v, 0)
    assert_eq(n, 2)
}
