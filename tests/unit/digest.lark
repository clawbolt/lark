// std/digest 的测试：标准的测试向量（FIPS 180、RFC 4231 和 RFC 2202 的 HMAC、RFC 3720 附录里的 CRC-32 校验值等）
import "std/digest"
import "std/str"

test "SHA-256" {
    assert_eq(h256(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(h256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(h256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    // 正好 55 / 56 / 64 字节：补位跨不跨块的边界
    assert_eq(len(digest.sha256(str.repeat("a", 55).to_bytes())), 32)
    assert(h256(str.repeat("a", 56)) != h256(str.repeat("a", 55)))
    assert_eq(h256(str.repeat("a", 1000000)), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
}

test "SHA-1" {
    assert_eq(h1(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    assert_eq(h1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
    assert_eq(h1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
}

test "SHA-512" {
    assert_eq(h512(""), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    assert_eq(h512("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    // 112 字节：补位后正好多出一块
    assert_eq(h512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
        "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
    assert_eq(len(digest.sha512(str.repeat("a", 111).to_bytes())), 64)
}

test "HMAC" {
    // RFC 4231 第 1、2、6 组（第 6 组的密钥比块长，先摘要一次）；RFC 2202 的 SHA-1 第 2 组
    hi = "Hi There".to_bytes()
    assert_eq(digest.to_hex(digest.hmac_sha256(rep(0x0b, 20), hi)), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    jefe = "Jefe".to_bytes()
    want = "what do ya want for nothing?".to_bytes()
    assert_eq(digest.to_hex(digest.hmac_sha256(jefe, want)), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    assert_eq(digest.to_hex(digest.hmac_sha512(jefe, want)),
        "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
    assert_eq(digest.to_hex(digest.hmac_sha1(jefe, want)), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    // 通用的 hmac 加上 SHA-256 和 hmac_sha256 一样
    assert(digest.equal(digest.hmac(|d| digest.sha256(d), 64, jefe, want), digest.hmac_sha256(jefe, want)))
    long = "Test Using Larger Than Block-Size Key - Hash Key First".to_bytes()
    assert_eq(digest.to_hex(digest.hmac_sha256(rep(0xaa, 131), long)), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
}

test "equal" {
    a = digest.hmac_sha256(jefe_key(), "x".to_bytes())
    b = digest.hmac_sha256(jefe_key(), "x".to_bytes())
    c = digest.hmac_sha256(jefe_key(), "y".to_bytes())
    assert(digest.equal(a, b))
    assert(!digest.equal(a, c))
    assert(!digest.equal(a, []))
    assert(digest.equal([], []))
}

test "CRC-32" {
    assert_eq(digest.crc32("123456789".to_bytes()), 0xCBF4_3926)
    assert_eq(digest.crc32([]), 0)
}

test "十六进制" {
    assert_eq(digest.to_hex([0, 15, 16, 255]), "000f10ff")
    match digest.from_hex("000F10ff") {
        Ok(b) => assert_eq(digest.to_hex(b), "000f10ff")
        Err(e) => panic(e)
    }
    assert_eq(hex_err("abc"), "十六进制：长度 3 是奇数")
    assert_eq(hex_err("zz"), "十六进制 第 1 个字符：不是十六进制数字")
    assert_eq(hex_err("0g"), "十六进制 第 2 个字符：不是十六进制数字")
    match digest.from_hex("") {
        Ok(b) => assert_eq(len(b), 0)
        Err(e) => panic(e)
    }
}

fn h256(s: str) -> str { digest.to_hex(digest.sha256(s.to_bytes())) }

fn h1(s: str) -> str { digest.to_hex(digest.sha1(s.to_bytes())) }

fn hex_err(s: str) -> str {
    match digest.from_hex(s) {
        Ok(_) => "<成功>"
        Err(e) => e.copy()
    }
}

fn h512(s: str) -> str { digest.to_hex(digest.sha512(s.to_bytes())) }

fn rep(b: int, n: int) -> [u8] {
    out: [u8] = []
    for _i in 0..n { out.push(b.wrap_u8()) }
    out
}

fn jefe_key() -> [u8] { "Jefe".to_bytes() }
