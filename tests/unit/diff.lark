// std/diff 的测试：编辑序列、统一格式，以及和系统的 diff -u 对比
import "std/diff"
import "std/proc"
import "std/os"
import "std/time"

test "编辑序列" {
    assert(diff.edits(["a", "b", "c"], ["a", "c"]) == [diff.SAME, diff.DEL, diff.SAME])
    none: [str] = []
    assert_eq(len(diff.edits(none, none)), 0)
    assert(diff.edits(none, ["x"]) == [diff.ADD])
    assert(diff.edits(["a", "b"], ["c", "d"]) == [1, 1, 2, 2])
    assert(diff.edits(["a", "b", "c", "a", "b", "b", "a"], ["c", "b", "a", "b", "a", "c"]) == [1, 1, 0, 2, 0, 0, 1, 0, 2])
    assert_eq(len(diff.lines_with_ends("a\nb")), 2)
    assert_eq(len(diff.lines_with_ends("")), 0)
}

test "统一格式" {
    assert_eq(diff.hunks("hello\nworld\n", "hello\nthere\nworld\n"), "@@ -1,2 +1,3 @@\n hello\n+there\n world\n")
    assert_eq(diff.hunks("a\n", "a"), "@@ -1 +1 @@\n-a\n+a\n\\ No newline at end of file\n")
    assert_eq(diff.unified("x", "y", "same\n", "same\n"), "")
    assert_eq(diff.unified("x", "y", "", "new\n"), "--- x\n+++ y\n@@ -0,0 +1 @@\n+new\n")
    text = "fn x\n1\n2\n3\n4\n5\n6\n7\n8\n9\n"
    changed = "fn x\n1\n2\n3\n4\n5\n6\n7\n8\nnine\n"
    assert_eq(diff.hunks(text, changed), "@@ -7,4 +7,4 @@\n 6\n 7\n 8\n-9\n+nine\n")
    assert_eq(diff.hunks_with(text, changed, diff.Opts(context: 1, func: true)), "@@ -9,2 +9,2 @@ fn x\n 8\n-9\n+nine\n")
    assert_eq(diff.hunks_with(text, changed, diff.Opts(context: 0, func: false)), "@@ -10 +10 @@\n-9\n+nine\n")
}

// 和 diff -u 的输出比（去掉带文件名和时间的头两行）
fn same_as_system(old: str, new: str) {
    dir = os.temp_dir()
    a = os.join_path(dir, "lark_diff_a_#{time.unix_ms()}")
    b = a + "_b"
    match os.write(a, old) {
        Ok(_) => {}
        Err(e) => panic(e)
    }
    match os.write(b, new) {
        Ok(_) => {}
        Err(e) => panic(e)
    }
    want = match take proc.run(["diff", "-u", a, b]) {
        Ok(o) => o.out.copy()
        Err(e) => panic(e)
    }
    _ra = os.remove(a)
    _rb = os.remove(b)
    got = diff.unified(a, b, old, new)
    // 头两行带着修改时间，只比较 @@ 开始的部分
    assert_eq(after_header(got), after_header(want))
}

fn after_header(s: str) -> str {
    n = 0
    for i in 0..len(s) {
        if byte_at(s, i) == '\n' {
            n += 1
            if n == 2 { return slice(s, i + 1, len(s)) }
        }
    }
    ""
}

test "和 diff -u 一样" {
    old = ""
    new = ""
    for i in 0..60 {
        old += "第 #{i} 行\n"
        if i % 13 == 5 {
            new += "改过的第 #{i} 行\n"
        } else if i % 17 != 3 {
            new += "第 #{i} 行\n"
        }
        if i == 30 { new += "新加的一行\n" }
    }
    same_as_system(old, new)
    same_as_system("x\n", "y")
}

// 按编辑序列从 a 做出 b；SAME 的两行要真的相同
fn apply(a: [str], b: [str], ops: [int]) -> [str] {
    out: [str] = []
    i = 0
    j = 0
    for op in ops {
        if op == diff.SAME {
            assert_eq(a[i], b[j])
            out.push(a[i].copy())
            i += 1
            j += 1
        } else if op == diff.DEL {
            i += 1
        } else {
            out.push(b[j].copy())
            j += 1
        }
    }
    assert(i == len(a) && j == len(b))
    out
}

fn count(ops: [int], want: int) -> int {
    n = 0
    for op in ops {
        if op == want { n += 1 }
    }
    n
}

// 改动多到超过倒推记录的上限（D > 2000）时换成线性空间的分治：结果照样是最短的
test "改动很多的大文件" {
    a: [str] = []
    b: [str] = []
    for i in 0..4000 {
        a.push("行 #{i}\n")
        b.push(if i % 2 == 0 { "行 #{i}\n" } else { "改 #{i}\n" })
    }
    // 中间再插一段、删一段，让两边长度不同
    for i in 0..300 { b.insert_at(1000, "新 #{i}\n") }
    for _i in 0..200 { _x = a.remove_at(3000) }
    ops = diff.edits(a, b)
    assert(apply(a, b, ops) == b)
    // 最长公共部分：没改的偶数行，减去被删的那段里的 100 行
    assert_eq(count(ops, diff.SAME), 2000 - 100)
    assert_eq(count(ops, diff.DEL), len(a) - 1900)
    assert_eq(count(ops, diff.ADD), len(b) - 1900)
    // 完全不一样的两边
    x: [str] = []
    y: [str] = []
    for i in 0..3000 {
        x.push("x#{i}")
        y.push("y#{i}")
    }
    o2 = diff.edits(x, y)
    assert(count(o2, diff.SAME) == 0 && count(o2, diff.DEL) == 3000 && count(o2, diff.ADD) == 3000)
    // 先列删掉的、再列加上的
    assert_eq(o2[0], diff.DEL)
    assert_eq(o2[2999], diff.DEL)
    assert_eq(o2[3000], diff.ADD)
}
