// 标准库的公开类型都能直接插值（docs/std.md 第四节“类型”）：容器显示成 {k: v, …} 或 [a, b]，
// 数据显示成构造它的写法，句柄显示成 Conn(fd 3)
import "std/map"
import "std/set"
import "std/deque"
import "std/heap"
import "std/time"
import "std/re"
import "std/http"
import "std/os"
import "std/proc"
import "std/net"
import "std/io"
import "std/rand"
import "std/diff"
import "std/log"
import "std/flag"

test "容器" {
    m: map.Map[str, int] = map.new()
    assert_eq("#{m}", "{}")
    m["b"] = 2
    m["a"] = 1
    assert_eq("#{m}", "{\"b\": 2, \"a\": 1}")
    // 值是列表、键是 int：按列表里元素的写法
    m2: map.Map[int, [str]] = map.new()
    m2[1] = ["x"]
    assert_eq("#{m2}", "{1: [\"x\"]}")
    assert_eq("#{set.of(["甲", "乙", "甲"])}", "{\"甲\", \"乙\"}")
    e: set.Set[int] = set.new()
    assert_eq("#{e}", "{}")
    assert_eq("#{deque.of([3, 1])}", "[3, 1]")
    // 堆从小到大显示，显示以后堆本身不变
    h = heap.of([5, 1, 4, 1])
    assert_eq("#{h}", "[1, 1, 4, 5]")
    assert_eq(len(h), 4)
    // 放进列表、T? 里也能插值
    assert_eq("#{[set.of([1])]}", "[{1}]")
    sm: map.Map[str, int]? = Some(map.new())
    assert_eq("#{sm}", "Some({})")
}

test "数据" {
    assert_eq("#{time.date_utc(1_793_001_120_123)}", "2026-10-26 07:52:00.123")
    assert_eq("#{time.date_utc(5)}", "1970-01-01 00:00:00.005")
    assert(str_starts("#{time.now()}", "Instant("))
    r = match take re.compile("(?i)a+b") {
        Ok(x) => x
        Err(e) => panic(e)
    }
    assert_eq("#{r}", "Re(\"(?i)a+b\")")
    req, _n, _code = http.parse_request("GET /a?b=1 HTTP/1.1\r\nHost: x\r\n\r\n", 0)
    assert_eq("#{req}", "Some(GET /a?b=1 HTTP/1.1)")
    resp = http.Response(status: 404, reason: "Not Found", headers: [], body: "")
    assert_eq("#{resp}", "404 Not Found")
    fi = os.FileInfo(is_file: true, is_dir: false, is_symlink: false, size: 12, mtime_ms: 7, mode: 0o644)
    assert_eq("#{fi}", "FileInfo(is_file: true, is_dir: false, is_symlink: false, size: 12, mtime_ms: 7, mode: 0o644)")
    o = proc.Output(code: 1, out: "ok", err: "")
    assert_eq("#{o}", "Output(code: 1, out: \"ok\", err: \"\")")
    assert_eq("#{diff.Opts(context: 3, func: false)}", "Opts(context: 3, func: false)")
    lg = log.new("svc")
    lg.level = log.WARN
    assert_eq("#{lg}", "Logger(svc, WARN)")
}

test "句柄和解析器" {
    assert_eq("#{io.stdin()}", "Reader(fd 0)")
    assert_eq("#{io.stdout()}", "Writer(fd 1)")
    l = match take net.listen("127.0.0.1", 0) {
        Ok(x) => x
        Err(e) => panic(e)
    }
    assert(str_starts("#{l}", "Listener(fd "))
    assert_eq("#{rand.new(1)}", "Rng(…)")
    p = flag.new("tool", "说明")
    p.add_bool("verbose", "v", "多说点")
    p.add_int("n", "", 3, "次数")
    assert_eq("#{p}", "Parser(tool, 2 个选项)")
    a = match take p.parse_from(["-v", "x"]) {
        Ok(x) => x
        Err(e) => panic(e)
    }
    assert_eq("#{a}", "Args(verbose=true, n=3, rest: [\"x\"])")
}

fn str_starts(s: str, p: str) -> bool { len(s) >= len(p) && slice(s, 0, len(p)) == p }
