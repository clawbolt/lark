// lredis · 数据库：键 → 值（字符串、列表、哈希），可以带过期时间。exec 执行一条命令，得到 RESP 编码的回复。
// 只有一个线程（main.lark 的 store_loop）拥有数据库，所有连接把命令发给它，所以这里不用加锁。
//
// 每个键占一个槽位，各种值放在按槽位编号的几个并列列表里（kinds 记是哪一种）。
// 这样改列表、哈希可以原地改（db.lists[i].push_back(x)），不用先取出来再放回去。
import "std/map"
import "std/deque"
import "std/str"
import "resp"

const KIND_NONE = 0
const KIND_STR = 1
const KIND_LIST = 2
const KIND_HASH = 3

pub type Db {
    slot_of: map.Map[str, int]
    keys: [str]                     // 槽位的键；空闲的槽位是 ""
    kinds: [int]
    strs: [str]
    lists: [deque.Deque[str]]
    hashes: [map.Map[str, str]]
    exps: [int]                     // 过期的时刻（Unix 毫秒），0 表示不过期
    free: [int]                     // 空闲的槽位
    live: int                       // 键的个数
}

pub fn new_db() -> Db {
    Db(slot_of: map.new(), keys: [], kinds: [], strs: [], lists: [], hashes: [], exps: [], free: [], live: 0)
}

pub fn size(db: Db) -> int { db.live }

fn empty_list() -> deque.Deque[str] { deque.new() }

fn empty_hash() -> map.Map[str, str] { map.new() }

// k 的槽位；没有、或者已经过期（顺便删掉）时 -1
fn find(inout db: Db, k: str, now: int) -> int {
    i = db.slot_of.get(k) ?? -1
    if i >= 0 && db.exps[i] != 0 && db.exps[i] <= now {
        del_slot(&db, i)
        return -1
    }
    i
}

fn del_slot(inout db: Db, i: int) {
    k = db.keys[i].copy()
    _old = db.slot_of.remove(k)
    db.keys[i] = ""
    db.kinds[i] = KIND_NONE
    db.strs[i] = ""
    db.lists[i] = empty_list()
    db.hashes[i] = empty_hash()
    db.exps[i] = 0
    db.free.push(i)
    db.live -= 1
}

fn new_slot(inout db: Db, k: str, kind: int) -> int {
    i = -1
    if len(db.free) > 0 {
        i = db.free.pop()
    } else {
        db.keys.push("")
        db.kinds.push(KIND_NONE)
        db.strs.push("")
        db.lists.push(empty_list())
        db.hashes.push(empty_hash())
        db.exps.push(0)
        i = len(db.keys) - 1
    }
    db.keys[i] = k.copy()
    db.kinds[i] = kind
    db.exps[i] = 0
    db.slot_of.insert(k.copy(), i)
    db.live += 1
    i
}

// 要写的槽位：k 不存在时新建一个 kind 类型的；类型不对时 -2
fn slot_for_write(inout db: Db, k: str, kind: int, now: int) -> int {
    i = find(&db, k, now)
    if i < 0 { return new_slot(&db, k, kind) }
    if db.kinds[i] != kind { return -2 }
    i
}

// 要读的槽位：不存在时 -1，类型不对时 -2
fn slot_for_read(inout db: Db, k: str, kind: int, now: int) -> int {
    i = find(&db, k, now)
    if i >= 0 && db.kinds[i] != kind { return -2 }
    i
}

// 删掉过期的键（main.lark 每 100 毫秒调用一次；读写时也会顺便检查，见 find）
pub fn sweep(inout db: Db, now: int) {
    for i in 0..len(db.keys) {
        if db.kinds[i] != KIND_NONE && db.exps[i] != 0 && db.exps[i] <= now { del_slot(&db, i) }
    }
}

fn flush_all(inout db: Db) { db = new_db() }

fn int_max() -> int { 4611686018427387903 * 2 + 1 }

fn int_min() -> int { 0 - int_max() - 1 }

// ---------- 参数个数 ----------

// 每个命令的参数个数（含命令名）：最少、最多（-1 不限）、从第几个参数开始要成对（0 表示不要求；MSET 从 1 开始，HSET 从 2 开始）
fn arity(name: str) -> (int, int, int) {
    if name == "ping" { return (1, 2, 0) }
    if name == "echo" || name == "get" || name == "incr" || name == "decr" || name == "strlen" || name == "ttl" || name == "pttl" ||
        name == "persist" || name == "type" || name == "llen" || name == "hgetall" || name == "hlen" || name == "hkeys" ||
        name == "hvals" || name == "keys" || name == "select" || name == "getdel" {
        return (2, 2, 0)
    }
    if name == "set" { return (3, -1, 0) }
    if name == "incrby" || name == "decrby" || name == "append" || name == "expire" || name == "pexpire" || name == "lindex" ||
        name == "hget" || name == "hexists" || name == "setnx" || name == "getset" {
        return (3, 3, 0)
    }
    if name == "del" || name == "exists" || name == "unlink" || name == "mget" { return (2, -1, 0) }
    if name == "mset" { return (3, -1, 1) }
    if name == "hset" { return (4, -1, 2) }
    if name == "lpush" || name == "rpush" || name == "hdel" { return (3, -1, 0) }
    if name == "lpop" || name == "rpop" { return (2, 3, 0) }
    if name == "lrange" { return (4, 4, 0) }
    if name == "dbsize" { return (1, 1, 0) }
    if name == "flushdb" || name == "flushall" { return (1, 2, 0) }
    if name == "info" || name == "command" || name == "client" || name == "config" { return (1, -1, 0) }
    (-1, -1, 0)
}

// ---------- 执行命令 ----------

// args[0] 是命令名（不分大小写）；now 是现在的 Unix 毫秒（测试时可以固定）
pub fn exec(inout db: Db, args: [str], now: int) -> str {
    name = str.to_lower(args[0])
    n = len(args)
    lo, hi, pair_from = arity(name)
    if lo < 0 { return resp.unknown(args) }
    if n < lo || (hi >= 0 && n > hi) { return resp.wrong_args(name) }
    if pair_from > 0 && (n - pair_from) % 2 != 0 { return resp.wrong_args(name) }
    if name == "ping" { return if n == 2 { resp.bulk(args[1]) } else { resp.simple("PONG") } }
    if name == "echo" { return resp.bulk(args[1]) }
    if name == "select" { return if args[1] == "0" { resp.ok() } else { resp.error("ERR DB index is out of range") } }
    if name == "dbsize" { return resp.integer(db.live) }
    if name == "flushdb" || name == "flushall" {
        flush_all(&db)
        return resp.ok()
    }
    if name == "command" { return resp.array([]) }
    if name == "client" { return resp.ok() }
    if name == "config" { return cmd_config(args) }
    if name == "info" { return cmd_info(db) }
    if name == "keys" { return cmd_keys(&db, args[1], now) }
    if name == "del" || name == "unlink" || name == "exists" { return cmd_del_exists(&db, name, args, now) }
    if name == "type" { return cmd_type(&db, args[1], now) }
    if name == "expire" || name == "pexpire" || name == "ttl" || name == "pttl" || name == "persist" { return cmd_expire(&db, name, args, now) }
    if name == "get" || name == "set" || name == "setnx" || name == "getset" || name == "getdel" || name == "mget" || name == "mset" ||
        name == "incr" || name == "decr" || name == "incrby" || name == "decrby" || name == "append" || name == "strlen" {
        return cmd_string(&db, name, args, now)
    }
    if name == "lpush" || name == "rpush" || name == "lpop" || name == "rpop" || name == "llen" || name == "lrange" || name == "lindex" {
        return cmd_list(&db, name, args, now)
    }
    cmd_hash(&db, name, args, now)
}

fn cmd_config(args: [str]) -> str {
    if len(args) >= 3 && str.to_lower(args[1]) == "get" { return resp.bulks([args[2].copy(), ""]) }
    if len(args) >= 2 && str.to_lower(args[1]) == "set" { return resp.ok() }
    resp.error("ERR unknown subcommand or wrong number of arguments for 'config' command")
}

fn cmd_info(db: Db) -> str {
    expires = 0
    for i in 0..len(db.keys) {
        if db.kinds[i] != KIND_NONE && db.exps[i] != 0 { expires += 1 }
    }
    resp.bulk("# Server\r\nredis_version:7.0.0\r\nlredis_version:0.1.0\r\n\r\n# Keyspace\r\ndb0:keys=#{db.live},expires=#{expires},avg_ttl=0\r\n")
}

fn cmd_keys(inout db: Db, pat: str, now: int) -> str {
    sweep(&db, now)
    out: [str] = []
    for i in 0..len(db.keys) {
        if db.kinds[i] != KIND_NONE && glob(pat, db.keys[i]) { out.push(db.keys[i].copy()) }
    }
    resp.bulks(out)
}

fn cmd_del_exists(inout db: Db, name: str, args: [str], now: int) -> str {
    count = 0
    for k in 1..len(args) {
        i = find(&db, args[k], now)
        if i >= 0 {
            count += 1
            if name != "exists" { del_slot(&db, i) }
        }
    }
    resp.integer(count)
}

fn cmd_type(inout db: Db, k: str, now: int) -> str {
    i = find(&db, k, now)
    if i < 0 { return resp.simple("none") }
    kind = db.kinds[i]
    resp.simple(if kind == KIND_STR { "string" } else if kind == KIND_LIST { "list" } else { "hash" })
}

fn cmd_expire(inout db: Db, name: str, args: [str], now: int) -> str {
    i = find(&db, args[1], now)
    if name == "ttl" || name == "pttl" {
        if i < 0 { return resp.integer(-2) }
        if db.exps[i] == 0 { return resp.integer(-1) }
        left = db.exps[i] - now
        return resp.integer(if name == "ttl" { (left + 500) / 1000 } else { left })
    }
    if name == "persist" {
        if i < 0 || db.exps[i] == 0 { return resp.integer(0) }
        db.exps[i] = 0
        return resp.integer(1)
    }
    v = resp.parse_int(args[2]) ?? int_min()
    if v == int_min() { return resp.not_int() }
    // 秒换成毫秒、再加上现在的时刻，都不能溢出
    limit = if name == "expire" { (int_max() - now) / 1000 } else { int_max() - now }
    if v > limit { return resp.error("ERR invalid expire time in '#{name}' command") }
    if i < 0 { return resp.integer(0) }
    ms = if name == "expire" { v * 1000 } else { v }
    if ms <= 0 {
        // 过期时间不是正数：直接删掉（和 Redis 一样）
        del_slot(&db, i)
    } else {
        db.exps[i] = now + ms
    }
    resp.integer(1)
}

// ---------- 字符串 ----------

fn cmd_string(inout db: Db, name: str, args: [str], now: int) -> str {
    if name == "get" || name == "getdel" {
        i = slot_for_read(&db, args[1], KIND_STR, now)
        if i == -2 { return resp.wrong_type() }
        if i < 0 { return resp.nil() }
        r = resp.bulk(db.strs[i])
        if name == "getdel" { del_slot(&db, i) }
        return r
    }
    if name == "mget" {
        items: [str] = []
        for k in 1..len(args) {
            i = slot_for_read(&db, args[k], KIND_STR, now)
            items.push(if i >= 0 { resp.bulk(db.strs[i]) } else { resp.nil() })
        }
        return resp.array(items)
    }
    if name == "mset" {
        k = 1
        for k + 1 < len(args) {
            set_str(&db, args[k], args[k + 1], now)
            k += 2
        }
        return resp.ok()
    }
    if name == "set" { return cmd_set(&db, args, now) }
    if name == "setnx" {
        if find(&db, args[1], now) >= 0 { return resp.integer(0) }
        set_str(&db, args[1], args[2], now)
        return resp.integer(1)
    }
    if name == "getset" {
        i = slot_for_read(&db, args[1], KIND_STR, now)
        if i == -2 { return resp.wrong_type() }
        old = if i >= 0 { resp.bulk(db.strs[i]) } else { resp.nil() }
        set_str(&db, args[1], args[2], now)
        return old
    }
    if name == "strlen" {
        i = slot_for_read(&db, args[1], KIND_STR, now)
        if i == -2 { return resp.wrong_type() }
        return resp.integer(if i >= 0 { len(db.strs[i]) } else { 0 })
    }
    if name == "append" {
        i = slot_for_write(&db, args[1], KIND_STR, now)
        if i == -2 { return resp.wrong_type() }
        db.strs[i] += args[2]
        return resp.integer(len(db.strs[i]))
    }
    // incr / decr / incrby / decrby
    delta = 1
    if name == "incrby" || name == "decrby" {
        delta = resp.parse_int(args[2]) ?? int_min()
        if delta == int_min() { return resp.not_int() }
    }
    if name == "decr" || name == "decrby" {
        if delta == int_min() { return resp.error("ERR decrement would overflow") }
        delta = 0 - delta
    }
    i = slot_for_read(&db, args[1], KIND_STR, now)
    if i == -2 { return resp.wrong_type() }
    cur = 0
    if i >= 0 {
        cur = resp.parse_int(db.strs[i]) ?? int_min()
        if cur == int_min() && db.strs[i] != "-9223372036854775808" { return resp.not_int() }
    }
    if (delta > 0 && cur > int_max() - delta) || (delta < 0 && cur < int_min() - delta) {
        return resp.error("ERR increment or decrement would overflow")
    }
    v = cur + delta
    if i < 0 { i = new_slot(&db, args[1], KIND_STR) }
    db.strs[i] = "#{v}"
    resp.integer(v)
}

// 设成字符串值，去掉原来的值和过期时间
fn set_str(inout db: Db, k: str, v: str, now: int) {
    i = find(&db, k, now)
    if i >= 0 && db.kinds[i] != KIND_STR {
        del_slot(&db, i)
        i = -1
    }
    if i < 0 { i = new_slot(&db, k, KIND_STR) }
    db.strs[i] = v.copy()
    db.exps[i] = 0
}

// SET 键 值 [NX | XX] [GET] [EX 秒 | PX 毫秒 | EXAT 秒 | PXAT 毫秒 | KEEPTTL]
fn cmd_set(inout db: Db, args: [str], now: int) -> str {
    nx = false
    xx = false
    want_old = false
    keep = false
    deadline = 0
    has_exp = false
    k = 3
    for k < len(args) {
        o = str.to_lower(args[k])
        if o == "nx" && !xx {
            nx = true
        } else if o == "xx" && !nx {
            xx = true
        } else if o == "get" {
            want_old = true
        } else if o == "keepttl" && !has_exp {
            keep = true
        } else if (o == "ex" || o == "px" || o == "exat" || o == "pxat") && !has_exp && !keep && k + 1 < len(args) {
            v = resp.parse_int(args[k + 1]) ?? int_min()
            if v == int_min() { return resp.not_int() }
            if v <= 0 || v > (int_max() - now) / 1000 { return resp.error("ERR invalid expire time in 'set' command") }
            deadline = if o == "ex" { now + v * 1000 } else if o == "px" { now + v } else if o == "exat" { v * 1000 } else { v }
            has_exp = true
            k += 1
        } else {
            return resp.syntax()
        }
        k += 1
    }
    i = find(&db, args[1], now)
    old = resp.nil()
    if want_old && i >= 0 {
        if db.kinds[i] != KIND_STR { return resp.wrong_type() }
        old = resp.bulk(db.strs[i])
    }
    if (nx && i >= 0) || (xx && i < 0) { return if want_old { old } else { resp.nil() } }
    kept = if keep && i >= 0 { db.exps[i] } else { 0 }
    set_str(&db, args[1], args[2], now)
    j = find(&db, args[1], now)
    db.exps[j] = if has_exp { deadline } else { kept }
    if want_old { old } else { resp.ok() }
}

// ---------- 列表 ----------

// 下标可以是负数（-1 是最后一个）
fn norm_index(i: int, n: int) -> int { if i < 0 { i + n } else { i } }

fn cmd_list(inout db: Db, name: str, args: [str], now: int) -> str {
    if name == "lpush" || name == "rpush" {
        i = slot_for_write(&db, args[1], KIND_LIST, now)
        if i == -2 { return resp.wrong_type() }
        for k in 2..len(args) {
            if name == "lpush" { db.lists[i].push_front(args[k].copy()) } else { db.lists[i].push_back(args[k].copy()) }
        }
        return resp.integer(len(db.lists[i]))
    }
    i = slot_for_read(&db, args[1], KIND_LIST, now)
    if i == -2 { return resp.wrong_type() }
    if name == "llen" { return resp.integer(if i >= 0 { len(db.lists[i]) } else { 0 }) }
    if name == "lindex" {
        idx = resp.parse_int(args[2]) ?? int_min()
        if idx == int_min() { return resp.not_int() }
        if i < 0 { return resp.nil() }
        return match db.lists[i].get(norm_index(idx, len(db.lists[i]))) {
            Some(v) => resp.bulk(v)
            None => resp.nil()
        }
    }
    if name == "lrange" {
        a = resp.parse_int(args[2]) ?? int_min()
        b = resp.parse_int(args[3]) ?? int_min()
        if a == int_min() || b == int_min() { return resp.not_int() }
        if i < 0 { return resp.array([]) }
        n = len(db.lists[i])
        s = norm_index(a, n)
        e = norm_index(b, n)
        if s < 0 { s = 0 }
        if e >= n { e = n - 1 }
        out: [str] = []
        if s <= e {
            for k in s..e + 1 { out.push(db.lists[i].get(k) ?? "") }
        }
        return resp.bulks(out)
    }
    // lpop / rpop [数量]
    has_count = len(args) == 3
    count = 1
    if has_count {
        count = resp.parse_int(args[2]) ?? -1
        if count < 0 { return resp.error("ERR value is out of range, must be positive") }
    }
    if i < 0 { return if has_count { resp.nil_array() } else { resp.nil() } }
    out: [str] = []
    for _n in 0..count {
        if len(db.lists[i]) == 0 { break }
        v = if name == "lpop" { db.lists[i].pop_front() } else { db.lists[i].pop_back() }
        out.push(v ?? "")
    }
    // 列表空了就删掉这个键（和 Redis 一样，不存在空列表）
    if len(db.lists[i]) == 0 { del_slot(&db, i) }
    if has_count { return resp.bulks(out) }
    resp.bulk(out[0])
}

// ---------- 哈希 ----------

fn cmd_hash(inout db: Db, name: str, args: [str], now: int) -> str {
    if name == "hset" {
        i = slot_for_write(&db, args[1], KIND_HASH, now)
        if i == -2 { return resp.wrong_type() }
        added = 0
        k = 2
        for k + 1 < len(args) {
            if !db.hashes[i].contains_key(args[k]) { added += 1 }
            db.hashes[i].insert(args[k].copy(), args[k + 1].copy())
            k += 2
        }
        return resp.integer(added)
    }
    i = slot_for_read(&db, args[1], KIND_HASH, now)
    if i == -2 { return resp.wrong_type() }
    if name == "hget" {
        if i < 0 { return resp.nil() }
        return match db.hashes[i].get(args[2]) {
            Some(v) => resp.bulk(v)
            None => resp.nil()
        }
    }
    if name == "hexists" { return resp.integer(if i >= 0 && db.hashes[i].contains_key(args[2]) { 1 } else { 0 }) }
    if name == "hlen" { return resp.integer(if i >= 0 { len(db.hashes[i]) } else { 0 }) }
    if name == "hdel" {
        if i < 0 { return resp.integer(0) }
        removed = 0
        for k in 2..len(args) {
            if db.hashes[i].remove(args[k]) != None { removed += 1 }
        }
        if len(db.hashes[i]) == 0 { del_slot(&db, i) }
        return resp.integer(removed)
    }
    // hgetall / hkeys / hvals
    out: [str] = []
    if i >= 0 {
        for j in 0..len(db.hashes[i]) {
            if name != "hvals" { out.push(db.hashes[i].keys[j].copy()) }
            if name != "hkeys" { out.push(db.hashes[i].vals[j].copy()) }
        }
    }
    resp.bulks(out)
}

// ---------- 通配符（KEYS 用）----------

// * 任意多个字节，? 一个字节，[abc] [a-z] [^a] 其中一个，\x 就是 x
pub fn glob(pat: str, s: str) -> bool { glob_at(pat, 0, s, 0) }

fn glob_at(pat: str, pi: int, s: str, si: int) -> bool {
    p = pi
    i = si
    for p < len(pat) {
        c = byte_at(pat, p)
        if c == '*' {
            for p + 1 < len(pat) && byte_at(pat, p + 1) == '*' { p += 1 }
            if p + 1 == len(pat) { return true }
            for k in i..len(s) + 1 {
                if glob_at(pat, p + 1, s, k) { return true }
            }
            return false
        }
        if i >= len(s) { return false }
        if c == '?' {
            p += 1
            i += 1
        } else if c == '[' {
            q = p + 1
            neg = q < len(pat) && byte_at(pat, q) == '^'
            if neg { q += 1 }
            hit = false
            ch = byte_at(s, i)
            for q < len(pat) && byte_at(pat, q) != ']' {
                if byte_at(pat, q) == '\\' && q + 1 < len(pat) {
                    if byte_at(pat, q + 1) == ch { hit = true }
                    q += 2
                } else if q + 2 < len(pat) && byte_at(pat, q + 1) == '-' && byte_at(pat, q + 2) != ']' {
                    lo = byte_at(pat, q)
                    hi = byte_at(pat, q + 2)
                    if (lo <= ch && ch <= hi) || (hi <= ch && ch <= lo) { hit = true }
                    q += 3
                } else {
                    if byte_at(pat, q) == ch { hit = true }
                    q += 1
                }
            }
            if hit == neg { return false }
            p = q + 1
            i += 1
        } else {
            if c == '\\' && p + 1 < len(pat) { p += 1 }
            if byte_at(pat, p) != byte_at(s, i) { return false }
            p += 1
            i += 1
        }
    }
    i == len(s)
}
