// X.509 证书（RFC 5280）里 TLS 要用的部分：Ed25519 公钥（SubjectPublicKeyInfo，RFC 8410 第 4 节）和证书的最外层
// （tbsCertificate、签名算法、签名，RFC 5280 第 4.1 节；签名算法只认 Ed25519，RFC 8410 第 6 节）。
// 先证明再写：对应 formal/Lark/Der.lean，函数和定义一一对应：
//   ed_oid ↔ edOid（1.3.101.112）、spki / parse_spki ↔ spki / parseSpki（parseSpki_spki、parseSpki_some：
//   只认 32 字节的 Ed25519 公钥，写法一个字节都不能差）
//   alg ↔ edAlg、cert_write / parse_cert ↔ certW / parseCert（parseCert_certW、parseCert_some）
// 签名要验的是 tbsCertificate 原样的那段字节（Cert.tbs）。证书里的名字、有效期、扩展、证书链还没做。实验性：没有经过审计
import "tls/der"
import "tls/ed25519"

fn cat(a: [u8], b: [u8]) -> [u8] {
    out = a.copy()
    for x in b { out.push(x) }
    out
}

fn sub(d: [u8], a: int, b: int) -> [u8] {
    out: [u8] = []
    for i in a..b { out.push(d[i]) }
    out
}

// BIT STRING 的内容：第一个字节是最后没用的位数，这里都是 0
fn bits(b: [u8]) -> [u8] { cat([0], b) }

// 1.3.101.112（id-Ed25519）
pub fn ed_oid() -> [u8] { [43, 101, 112] }

// AlgorithmIdentifier：SEQUENCE { OID 1.3.101.112 }，没有参数
pub fn alg() -> [u8] { der.tlv(der.SEQUENCE, der.tlv(der.OID, ed_oid())) }

// SEQUENCE { AlgorithmIdentifier, BIT STRING 公钥 }，32 字节的公钥时一共 44 字节
pub fn spki(pk: [u8]) -> [u8] { der.tlv(der.SEQUENCE, cat(alg(), der.tlv(der.BIT_STRING, bits(pk)))) }

pub fn parse_spki(d: [u8]) -> [u8]! {
    if len(d) != 44 { return Err("x509：Ed25519 公钥要 44 字节，这里是 #{len(d)} 字节") }
    pk = sub(d, 12, 44)
    if spki(pk) != d { return Err("x509：不是 Ed25519 公钥的写法") }
    Ok(pk)
}

// SEQUENCE { tbsCertificate, AlgorithmIdentifier, BIT STRING 签名 }；tbs 是完整的一个元素（含标签和长度）
pub fn cert_write(tbs: [u8], sig: [u8]) -> [u8] {
    der.tlv(der.SEQUENCE, cat(tbs, cat(alg(), der.tlv(der.BIT_STRING, bits(sig)))))
}

pub type Cert {
    pub tbs: [u8]    // tbsCertificate 原样的字节，签名签的就是它
    pub sig: [u8]    // 64 字节
}

pub fn parse_cert(d: [u8]) -> Cert! {
    outer = der.parse_tlv(d, 0)?
    if outer.tag != der.SEQUENCE || outer.next != len(d) { return Err("x509：证书要正好是一个 SEQUENCE") }
    t = der.parse_tlv(outer.body, 0)?
    if t.tag != der.SEQUENCE { return Err("x509：tbsCertificate 不是 SEQUENCE") }
    r = sub(outer.body, t.next, len(outer.body))
    // 签名算法 7 字节 + 签名的 BIT STRING 67 字节（3 字节的头 + 64 字节），签名是最后 64 字节
    if len(r) != 74 { return Err("x509：签名算法和签名一共要 74 字节，这里是 #{len(r)} 字节") }
    sig = sub(r, 10, 74)
    if r != cat(alg(), der.tlv(der.BIT_STRING, bits(sig))) { return Err("x509：签名算法不是 Ed25519") }
    Ok(Cert(tbs: der.tlv(der.SEQUENCE, t.body), sig: sig))
}

// 用签发者的 Ed25519 公钥验证证书的签名
pub fn verify(issuer_pk: [u8], c: Cert) -> bool { ed25519.verify(issuer_pk, c.tbs, c.sig) }

// tbsCertificate 里接连的元素：版本、序列号、签名算法、签发者、有效期、主体、公钥，后面可能有扩展
pub fn tbs_fields(c: Cert) -> [der.Tlv]! {
    t = der.parse_tlv(c.tbs, 0)?
    der.all(t.body)
}
