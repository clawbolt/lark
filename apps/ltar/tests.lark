// ltar 的单元测试：lark test（在 apps/ltar 里运行）。只测 tar 格式的读写，不碰文件；和系统 tar 的对照在 tests/e2e.sh
import "tar/tar"
import "std/str"

fn bs(s: str) -> [u8] { s.to_bytes() }

fn pack(es: [tar.Entry]) -> [u8] {
    out: [u8] = []
    for e in es {
        match tar.write_entry(&out, e) {
            Ok => {}
            Err(m) => panic(m)
        }
    }
    tar.finish(&out)
    out
}

fn unpack(d: [u8]) -> [tar.Entry] {
    match take tar.parse(d) {
        Ok(es) => es
        Err(e) => panic(e)
    }
}

fn parse_err(d: [u8]) -> str {
    match tar.parse(d) {
        Ok(_) => "<成功>"
        Err(e) => e
    }
}

// d[a..b] 拼成 str
fn text(d: [u8], a: int, b: int) -> str {
    out: [u8] = []
    for i in a..b { out.push(d[i]) }
    from_bytes(out)
}

// 改过头以后重新算校验和（测试里手工造 pax 头用）
fn fix_sum(inout d: [u8], off: int) {
    for i in 148..156 { d[off + i] = ' ' }
    sum = 0
    for i in 0..512 { sum += d[off + i].to_int() }
    for i in 0..6 {
        d[off + 153 - i] = ('0' + sum % 8).to_u8()
        sum = sum / 8
    }
    d[off + 154] = 0
}

test "写出来再读回去" {
    es = [
        tar.dir("src", 0o755, 1_700_000_000),
        tar.file("src/a.txt", 0o644, 1_700_000_001, bs("hello\n")),
        tar.file("src/run.sh", 0o755, 0, bs("#!/bin/sh\n")),
        tar.symlink("src/link", "a.txt", 5),
        tar.file("src/empty", 0o600, 0, [])
    ]
    d = pack(es)
    // 每项一个头；有内容的再加一块；最后两块空的
    assert_eq(len(d), 512 * (5 + 2 + 2))
    got = unpack(d)
    assert_eq(len(got), 5)
    assert_eq(got[0].kind, "dir")
    assert_eq(got[0].name, "src")
    assert_eq(got[0].mode, 0o755)
    assert_eq(got[0].mtime, 1_700_000_000)
    assert_eq(got[1].name, "src/a.txt")
    assert_eq(from_bytes(got[1].data), "hello\n")
    assert_eq(got[1].size, 6)
    assert_eq(got[2].mode, 0o755)
    assert_eq(got[3].kind, "symlink")
    assert_eq(got[3].link, "a.txt")
    assert_eq(got[4].size, 0)
    assert_eq("#{got[1]}", "file src/a.txt（6 字节，0o644）")
    assert_eq("#{got[3]}", "symlink src/link -> a.txt")
    assert_eq("#{got[0]}", "dir src（0o755）")
}

test "头的格式" {
    d = pack([tar.file("a.txt", 0o644, 8, bs("hi"))])
    assert_eq(text(d, 0, 5), "a.txt")
    assert_eq(text(d, 100, 108), "0000644" + from_byte(0))
    assert_eq(text(d, 124, 136), "00000000002" + from_byte(0))
    assert_eq(text(d, 136, 148), "00000000010" + from_byte(0))
    assert_eq(text(d, 156, 157), "0")
    assert_eq(text(d, 257, 263), "ustar" + from_byte(0))
    assert_eq(text(d, 263, 265), "00")
    // 校验和：6 位八进制、0、空格
    assert(d[154] == 0)
    assert(d[155] == ' ')
    // 目录的名字带结尾的 /，类型是 5
    e = pack([tar.dir("d", 0o755, 0)])
    assert_eq(text(e, 0, 2), "d/")
    assert_eq(text(e, 156, 157), "5")
}

test "长名字" {
    dirs = str.repeat("d", 120)
    long = dirs + "/" + str.repeat("f", 90)
    p, n = tar.split_name(long) ?? ("", "")
    assert_eq(p, dirs)
    assert_eq(len(n), 90)
    got = unpack(pack([tar.file(long, 0o644, 0, bs("x"))]))
    assert_eq(got[0].name, long)
    // 拆不开的：最后一段超过 100，或者整个超过 255
    match tar.split_name(str.repeat("a", 101)) {
        Ok(_) => panic("应该出错")
        Err(e) => assert(str.starts_with(e, "路径太长"))
    }
    match tar.split_name(str.repeat("a/", 130)) {
        Ok(_) => panic("应该出错")
        Err(e) => assert(str.starts_with(e, "路径太长"))
    }
}

test "pax 扩展头和 GNU 长名字" {
    // 先写一个普通的项，把它改成 pax 头：内容里的 path 覆盖下一项的名字
    rec = "27 path=very/long/name.txt\n"
    d: [u8] = []
    match tar.write_entry(&d, tar.file("PaxHeader", 0o644, 0, bs(rec))) {
        Ok => {}
        Err(m) => panic(m)
    }
    d[156] = 'x'
    fix_sum(&d, 0)
    rest = pack([tar.file("short", 0o644, 0, bs("内容"))])
    for b in rest { d.push(b) }
    got = unpack(d)
    assert_eq(len(got), 1)
    assert_eq(got[0].name, "very/long/name.txt")
    assert_eq(from_bytes(got[0].data), "内容")
    // GNU 的 'L'：内容就是下一项的名字
    g: [u8] = []
    match tar.write_entry(&g, tar.file("././@LongLink", 0o644, 0, bs("gnu/long/name" + from_byte(0)))) {
        Ok => {}
        Err(m) => panic(m)
    }
    g[156] = 'L'
    fix_sum(&g, 0)
    rest2 = pack([tar.dir("x", 0o755, 0)])
    for b in rest2 { g.push(b) }
    got2 = unpack(g)
    assert_eq(got2[0].name, "gnu/long/name")
    assert_eq(got2[0].kind, "dir")
}

test "坏的包" {
    assert_eq(parse_err(bs("garbage")), "tar 第 0 个字节：头不完整（只剩 7 个字节）")
    d = pack([tar.file("a", 0o644, 0, bs("hi"))])
    d[0] = 'b'
    assert_eq(parse_err(d), "tar 第 0 个字节：头的校验和不对，不是 tar 包，或者包坏了")
    e = pack([tar.file("a", 0o644, 0, bs("hi"))])
    cut: [u8] = []
    for i in 0..513 { cut.push(e[i]) }
    assert_eq(parse_err(cut), "tar 第 0 个字节：内容被截断了（要 2 个字节，只剩 1 个）")
    // 没有结尾的两个空块也能读（有的程序不写）
    short: [u8] = []
    for i in 0..1024 { short.push(e[i]) }
    assert_eq(len(unpack(short)), 1)
    empty: [u8] = []
    assert_eq(len(unpack(empty)), 0)
}

test "解包时拒绝的名字、权限的写法" {
    assert_eq(tar.unsafe_reason("a/b.txt"), "")
    assert_eq(tar.unsafe_reason("a/..b"), "")
    assert_eq(tar.unsafe_reason("/etc/passwd"), "是绝对路径")
    assert_eq(tar.unsafe_reason("a/../../x"), "里面有 ..")
    assert_eq(tar.unsafe_reason(".."), "里面有 ..")
    assert_eq(tar.unsafe_reason(""), "名字是空的")
    assert_eq(tar.mode_text(tar.file("a", 0o754, 0, [])), "-rwxr-xr--")
    assert_eq(tar.mode_text(tar.dir("d", 0o700, 0)), "drwx------")
    assert_eq(tar.mode_text(tar.symlink("l", "a", 0)), "lrwxrwxrwx")
}
