// 字符宽度：在终端里占几个格子。0：组合附加符号、零宽字符、变体选择符（跟在前一个字符后面）；
// 2：中日韩、谚文、全角、常见的 emoji；别的是 1。
// 先证明再写：对应 formal/Lark/VtUtf8.lean 的 zeroTab、wideTab、width，表的区间一个一个照抄。
// 证明了：宽度只有 0、1、2（width_le）；可显示的 ASCII 宽度都是 1（width_ascii，这里先判断，直接返回）；
// 两张表按区间从小到大排好、互不重叠（#guard sortedR，tests.lark 里也检查）。
// 没证：表只收了常用的区间，不是完整的 Unicode East Asian Width 表。

// [lo, hi, lo, hi, ...]，闭区间
pub fn zero_tab() -> [int] {
    [0x0300, 0x036F, 0x0483, 0x0489, 0x0591, 0x05BD, 0x0610, 0x061A, 0x064B, 0x065F,
        0x0E31, 0x0E31, 0x0E34, 0x0E3A, 0x0E47, 0x0E4E, 0x1AB0, 0x1AFF, 0x1DC0, 0x1DFF,
        0x200B, 0x200F, 0x202A, 0x202E, 0x2060, 0x2064, 0x20D0, 0x20FF, 0xFE00, 0xFE0F,
        0xFE20, 0xFE2F, 0xFEFF, 0xFEFF, 0xE0100, 0xE01EF]
}

pub fn wide_tab() -> [int] {
    [0x1100, 0x115F, 0x231A, 0x231B, 0x2329, 0x232A, 0x23E9, 0x23EC, 0x23F0, 0x23F0,
        0x23F3, 0x23F3, 0x25FD, 0x25FE, 0x2614, 0x2615, 0x2648, 0x2653, 0x267F, 0x267F,
        0x2693, 0x2693, 0x26A1, 0x26A1, 0x26AA, 0x26AB, 0x26BD, 0x26BE, 0x26C4, 0x26C5,
        0x26CE, 0x26CE, 0x26D4, 0x26D4, 0x26EA, 0x26EA, 0x26F2, 0x26F3, 0x26F5, 0x26F5,
        0x26FA, 0x26FA, 0x26FD, 0x26FD, 0x2705, 0x2705, 0x270A, 0x270B, 0x2728, 0x2728,
        0x274C, 0x274C, 0x274E, 0x274E, 0x2753, 0x2755, 0x2757, 0x2757, 0x2795, 0x2797,
        0x27B0, 0x27B0, 0x27BF, 0x27BF, 0x2B1B, 0x2B1C, 0x2B50, 0x2B50, 0x2B55, 0x2B55,
        0x2E80, 0x303E, 0x3041, 0x33FF, 0x3400, 0x4DBF, 0x4E00, 0x9FFF, 0xA000, 0xA4CF,
        0xA960, 0xA97F, 0xAC00, 0xD7A3, 0xF900, 0xFAFF, 0xFE10, 0xFE19, 0xFE30, 0xFE6F,
        0xFF00, 0xFF60, 0xFFE0, 0xFFE6, 0x1F004, 0x1F004, 0x1F0CF, 0x1F0CF, 0x1F18E, 0x1F18E,
        0x1F191, 0x1F19A, 0x1F200, 0x1F202, 0x1F210, 0x1F23B, 0x1F240, 0x1F248, 0x1F250, 0x1F251,
        0x1F300, 0x1F64F, 0x1F680, 0x1F6FF, 0x1F7E0, 0x1F7EB, 0x1F900, 0x1F9FF, 0x1FA70, 0x1FAFF,
        0x20000, 0x2FFFD, 0x30000, 0x3FFFD]
}

// 在不在这些区间里（inR）：区间排好了，二分找最后一个 lo ≤ c 的
pub fn in_r(t: [int], c: int) -> bool {
    lo = 0
    hi = len(t) / 2      // 找第一个 lo > c 的区间
    for lo < hi {
        mid = (lo + hi) / 2
        if t[mid * 2] <= c { lo = mid + 1 } else { hi = mid }
    }
    lo > 0 && c <= t[(lo - 1) * 2 + 1]
}

// 区间都是 lo ≤ hi，按从小到大排好、互不重叠（sortedR）
pub fn sorted_r(t: [int]) -> bool {
    if len(t) % 2 != 0 { return false }
    for i in 0..len(t) / 2 {
        if t[i * 2] > t[i * 2 + 1] { return false }
        if i > 0 && t[i * 2 - 1] >= t[i * 2] { return false }
    }
    true
}

pub fn width(c: int) -> int {
    if c < 0x7F { return 1 }    // width_ascii（表里的区间都从 0x7F 以后开始）
    if in_r(zero_tab(), c) { return 0 }
    if in_r(wide_tab(), c) { return 2 }
    1
}
