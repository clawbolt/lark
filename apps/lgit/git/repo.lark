// lgit · 仓库和对象：.git 目录、对象的读写、tree 和 commit 的格式、引用（分支）
// 对象存在 .git/objects/前两位/其余 38 位，内容是 zlib 压缩后的 “类型 长度\0正文”。
import "std/os"
import "std/str"
import "std/digest"
import "std/sort"
import "std/zlib"

pub type Obj {
    pub kind: str       // "blob" "tree" "commit" "tag"
    pub body: [u8]
}

// tree 里的一项：mode 是 "100644"（普通文件）、"100755"（可执行）、"40000"（子目录）、"120000"（符号链接）
pub type Entry {
    pub mode: str
    pub name: str
    pub id: str
}

pub type Commit {
    pub tree: str
    pub parents: [str]
    pub author: str     // "名字 <邮箱> 时间戳 时区"
    pub committer: str
    pub msg: str
}

// ---------- 仓库 ----------

// 从当前目录往上找 .git，得到工作区的根目录（绝对路径）
pub fn find_root() -> str! {
    d = os.cwd()?
    for true {
        if os.is_dir(os.join_path(d, ".git")) { return Ok(d) }
        up = os.dir(d)
        if up == d || up == "." { return Err("这里不是 git 仓库（往上也找不到 .git）") }
        d = up
    }
    Err("这里不是 git 仓库")
}

pub fn gdir(root: str) -> str { os.join_path(root, ".git") }

pub fn init(path: str) -> str! {
    g = os.join_path(path, ".git")
    if os.exists(g) { return Err("#{g} 已经存在") }
    for sub in ["objects", "refs/heads", "refs/tags"] { os.mkdir_all(os.join_path(g, sub))? }
    os.write(os.join_path(g, "HEAD"), "ref: refs/heads/main\n")?
    os.write(os.join_path(g, "config"), "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n")?
    Ok(g)
}

// ---------- 对象 ----------

fn framed(kind: str, body: [u8]) -> [u8] {
    head = "#{kind} #{len(body)}\0".to_bytes()
    out: [u8] = []
    out.reserve(len(head) + len(body))
    for b in head { out.push(b) }
    for b in body { out.push(b) }
    out
}

pub fn hash_of(kind: str, body: [u8]) -> str { digest.to_hex(digest.sha1(framed(kind, body))) }

fn obj_path(g: str, id: str) -> str { os.join_path(g, "objects/" + slice(id, 0, 2) + "/" + slice(id, 2, 40)) }

// 写进对象库（已经有了就不再写），得到编号
pub fn write_obj(g: str, kind: str, body: [u8]) -> str! {
    data = framed(kind, body)
    id = digest.to_hex(digest.sha1(data))
    p = obj_path(g, id)
    if os.is_file(p) { return Ok(id) }
    os.mkdir_all(os.dir(p))?
    // 先写临时文件再改名：中途出错不会留下半个对象
    tmp = p + ".tmp"
    os.write(tmp, from_bytes(zlib.compress(data)))?
    os.rename(tmp, p)?
    Ok(id)
}

pub fn read_obj(g: str, id: str) -> Obj! {
    p = obj_path(g, id)
    if !os.is_file(p) { return Err("没有对象 #{id}") }
    raw = os.read(p)?
    data = zlib.decompress(raw.to_bytes())?
    sp = -1
    nul = -1
    for i in 0..len(data) {
        if sp < 0 && data[i] == ' ' { sp = i }
        if data[i] == 0 {
            nul = i
            break
        }
    }
    if sp < 0 || nul < sp { return Err("对象 #{id} 的头不对") }
    kind = from_bytes(head_slice(data, 0, sp))
    n = try_parse_int(from_bytes(head_slice(data, sp + 1, nul))) ?? -1
    body = head_slice(data, nul + 1, len(data))
    if n != len(body) { return Err("对象 #{id} 的长度不对：头里写的是 #{n}，实际是 #{len(body)}") }
    Ok(Obj(kind: kind, body: body))
}

fn head_slice(d: [u8], a: int, b: int) -> [u8] {
    out: [u8] = []
    out.reserve(b - a)
    for i in a..b { out.push(d[i]) }
    out
}

// 编号可以只写前面几位（至少 4 位），有歧义时报错
pub fn expand_id(g: str, prefix: str) -> str! {
    if len(prefix) == 40 && is_hex(prefix) { return Ok(prefix.copy()) }
    if len(prefix) < 4 || len(prefix) > 40 { return Err("不认识的对象名 #{prefix}") }
    d = os.join_path(g, "objects/" + slice(prefix, 0, 2))
    if !os.is_dir(d) { return Err("没有以 #{prefix} 开头的对象") }
    rest = slice(prefix, 2, len(prefix))
    found: [str] = []
    for n in os.read_dir(d)? {
        if len(n) == 38 && str.starts_with(n, rest) { found.push(slice(prefix, 0, 2) + n) }
    }
    if len(found) == 0 { return Err("没有以 #{prefix} 开头的对象") }
    if len(found) > 1 { return Err("#{prefix} 有歧义：#{join(found, "、")}") }
    Ok(found[0].copy())
}

// ---------- tree ----------

pub fn parse_tree(body: [u8]) -> [Entry]! {
    out: [Entry] = []
    i = 0
    n = len(body)
    for i < n {
        sp = i
        for sp < n && body[sp] != ' ' { sp += 1 }
        nul = sp
        for nul < n && body[nul] != 0 { nul += 1 }
        if sp >= n || nul + 20 >= n + 1 { return Err("tree 的格式不对") }
        mode = from_bytes(head_slice(body, i, sp))
        name = from_bytes(head_slice(body, sp + 1, nul))
        id = digest.to_hex(head_slice(body, nul + 1, nul + 21))
        out.push(Entry(mode: mode, name: name, id: id))
        i = nul + 21
    }
    Ok(out)
}

// git 的排序：子目录按 “名字/” 比较
fn sort_key(e: Entry) -> str { if e.mode == "40000" { e.name + "/" } else { e.name.copy() } }

fn entry_cmp(a: Entry, b: Entry) -> int {
    ka = sort_key(a)
    kb = sort_key(b)
    if ka < kb { -1 } else if ka > kb { 1 } else { 0 }
}

pub fn tree_body(entries: [Entry]) -> [u8] {
    es = entries.copy()
    // git 要求 tree 里的项按 sort_key 排好；std/sort 的 sort_by 不要求 Ord，只要比较函数
    sort.sort_by(&es, entry_cmp)
    out: [u8] = []
    for e in es {
        for b in "#{e.mode} #{e.name}\0".to_bytes() { out.push(b) }
        match digest.from_hex(e.id) {
            Ok(raw) => {
                for b in raw { out.push(b) }
            }
            Err(_) => panic("tree_body：编号不对 #{e.id}")
        }
    }
    out
}

// ---------- commit ----------

pub fn parse_commit(body: [u8]) -> Commit! {
    text = from_bytes(body)
    c = Commit(tree: "", parents: [], author: "", committer: "", msg: "")
    k = str.find(text, "\n\n") ?? len(text)
    head = slice(text, 0, k)
    c.msg = if k + 2 <= len(text) { slice(text, k + 2, len(text)) } else { "" }
    for ln in str.lines(head) {
        if str.starts_with(ln, "tree ") {
            c.tree = slice(ln, 5, len(ln))
        } else if str.starts_with(ln, "parent ") {
            c.parents.push(slice(ln, 7, len(ln)))
        } else if str.starts_with(ln, "author ") {
            c.author = slice(ln, 7, len(ln))
        } else if str.starts_with(ln, "committer ") {
            c.committer = slice(ln, 10, len(ln))
        }
    }
    if c.tree == "" { return Err("commit 里没有 tree") }
    Ok(c)
}

pub fn commit_body(c: Commit) -> [u8] {
    s = "tree #{c.tree}\n"
    for p in c.parents { s += "parent #{p}\n" }
    s += "author #{c.author}\ncommitter #{c.committer}\n\n#{c.msg}"
    s.to_bytes()
}

// ---------- 引用 ----------

// HEAD 指向的分支（"refs/heads/main"）；HEAD 直接是编号（分离头指针）时为 ""
pub fn head_ref(g: str) -> str! {
    h = str.trim(os.read(os.join_path(g, "HEAD"))?)
    if str.starts_with(h, "ref: ") { Ok(slice(h, 5, len(h))) } else { Ok("") }
}

// 引用指向的编号；还没有提交时（新仓库的 main）为 None
pub fn read_ref(g: str, name: str) -> str? {
    p = os.join_path(g, name)
    if os.is_file(p) {
        v = str.trim(os.read(p) ?? "")
        if len(v) == 40 { return Some(v) }
    }
    // git gc 之后引用可能在 packed-refs 里
    packed = os.read(os.join_path(g, "packed-refs")) ?? ""
    for ln in str.lines(packed) {
        if len(ln) > 41 && slice(ln, 41, len(ln)) == name { return Some(slice(ln, 0, 40)) }
    }
    None
}

pub fn write_ref(g: str, name: str, id: str) -> ()! {
    p = os.join_path(g, name)
    os.mkdir_all(os.dir(p))?
    os.write(p, id + "\n")
}

// 删掉引用：松散的文件，还有 packed-refs 里的那一行（连同下面以 ^ 开头的那行）
pub fn delete_ref(g: str, name: str) -> ()! {
    p = os.join_path(g, name)
    if os.is_file(p) { os.remove(p)? }
    pp = os.join_path(g, "packed-refs")
    if !os.is_file(pp) { return Ok() }
    text = os.read(pp)?
    keep = ""
    skipping = false
    for ln in str.lines(text) {
        if skipping && str.starts_with(ln, "^") { continue }
        skipping = false
        if len(ln) > 41 && slice(ln, 41, len(ln)) == name {
            skipping = true
            continue
        }
        keep += ln + "\n"
    }
    os.write(pp, keep)
}

// HEAD 现在指向的提交
pub fn head_commit(g: str) -> str? {
    r = head_ref(g) ?? ""
    if r == "" {
        h = str.trim(os.read(os.join_path(g, "HEAD")) ?? "")
        if len(h) == 40 { return Some(h) }
        return None
    }
    read_ref(g, r)
}

// 版本的写法：HEAD、分支名、编号（可以只写前几位）
pub fn resolve(g: str, rev: str) -> str! {
    if rev == "HEAD" {
        h = head_commit(g) ?? ""
        if h == "" { return Err("还没有任何提交") }
        return Ok(h)
    }
    b = read_ref(g, "refs/heads/" + rev) ?? ""
    if b != "" { return Ok(b) }
    t = read_ref(g, "refs/tags/" + rev) ?? ""
    if t != "" { return Ok(t) }
    expand_id(g, rev)
}

fn is_hex(s: str) -> bool {
    match digest.from_hex(s) {
        Ok(_) => true
        Err(_) => false
    }
}
