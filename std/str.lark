// Lark 标准库 · 字符串（用 Lark 自己写）
// 查找：find / find_from / rfind（int?）、contains、count；切开：split、split_n、cut、words、lines；
// 去空白：trim / trim_start / trim_end，trim_prefix / trim_suffix；其它：starts_with、ends_with、replace_all、repeat、
// to_upper / to_lower、pad_start / pad_end。查找都是逐字节比较，不切出子串
// 下标和长度都按字节计算。

// 按分隔字符串切开（sep 为空时整个是一段）；连续的分隔符之间会得到空字符串：split("a,b,", ",") 是 ["a", "b", ""]。
// 和 Go 的 strings.Split、Rust 的 str::split 一样按字符串切；sep 只有一个字节时逐字节比较，不用找子串
pub fn split(s: str, sep: str) -> [str] {
    out: [str] = []
    if len(sep) == 0 {
        out.push(s)
        return out
    }
    start = 0
    if len(sep) == 1 {
        b = byte_at(sep, 0)
        for i in 0..len(s) {
            if byte_at(s, i) == b {
                out.push(slice(s, start, i))
                start = i + 1
            }
        }
        out.push(slice(s, start, len(s)))
        return out
    }
    i = index_from(s, sep, 0)
    for i >= 0 {
        out.push(slice(s, start, i))
        start = i + len(sep)
        i = index_from(s, sep, start)
    }
    out.push(slice(s, start, len(s)))
    out
}

// 按空白切开，丢掉空的部分
pub fn words(s: str) -> [str] {
    out: [str] = []
    start = -1
    for i in 0..len(s) + 1 {
        sp = i == len(s) || is_space(byte_at(s, i))
        if sp && start >= 0 {
            out.push(slice(s, start, i))
            start = -1
        } else if !sp && start < 0 {
            start = i
        }
    }
    out
}

fn is_space(b: int) -> bool { b == ' ' || b == '\t' || b == '\n' || b == '\r' }

pub fn starts_with(s: str, p: str) -> bool {
    len(p) <= len(s) && at(s, 0, p)
}

pub fn ends_with(s: str, p: str) -> bool {
    len(p) <= len(s) && at(s, len(s) - len(p), p)
}

// sub 是否正好出现在 s 的第 i 个字节处（调用方保证 i + len(sub) <= len(s)）。逐字节比较，不切出子串
fn at(s: str, i: int, sub: str) -> bool {
    for k in 0..len(sub) {
        if byte_at(s, i + k) != byte_at(sub, k) { return false }
    }
    true
}

// 从第 from 个字节起，sub 第一次出现的位置（可以是 -1，表示没有）。先比第一个字节，对上了才比后面的
fn index_from(s: str, sub: str, from: int) -> int {
    n = len(sub)
    i = if from < 0 { 0 } else { from }
    if n == 0 { return if i <= len(s) { i } else { -1 } }
    b0 = byte_at(sub, 0)
    last = len(s) - n
    for i <= last {
        if byte_at(s, i) == b0 && at(s, i, sub) { return i }
        i += 1
    }
    -1
}

// 子串第一次出现的位置；没有时为 None。sub 为空时是 0
pub fn find(s: str, sub: str) -> int? { find_from(s, sub, 0) }

// 从第 from 个字节起找（from 小于 0 时从头找）
pub fn find_from(s: str, sub: str, from: int) -> int? {
    i = index_from(s, sub, from)
    if i < 0 { None } else { Some(i) }
}

// 子串最后一次出现的位置
pub fn rfind(s: str, sub: str) -> int? {
    i = len(s) - len(sub)
    for i >= 0 {
        if at(s, i, sub) { return Some(i) }
        i -= 1
    }
    None
}

// 不重叠地数 sub 出现了几次（sub 为空时是 0）
pub fn count(s: str, sub: str) -> int {
    if len(sub) == 0 { return 0 }
    n = 0
    i = index_from(s, sub, 0)
    for i >= 0 {
        n += 1
        i = index_from(s, sub, i + len(sub))
    }
    n
}

// 去掉两头的空白（空格、\t、\n、\r）；trim_start / trim_end 只去一头
pub fn trim(s: str) -> str {
    a = 0
    b = len(s)
    for a < b && is_space(byte_at(s, a)) { a += 1 }
    for b > a && is_space(byte_at(s, b - 1)) { b -= 1 }
    slice(s, a, b)
}

pub fn trim_start(s: str) -> str {
    a = 0
    for a < len(s) && is_space(byte_at(s, a)) { a += 1 }
    slice(s, a, len(s))
}

pub fn trim_end(s: str) -> str {
    b = len(s)
    for b > 0 && is_space(byte_at(s, b - 1)) { b -= 1 }
    slice(s, 0, b)
}

// 去掉开头的 p（不是以 p 开头时原样返回）；trim_suffix 去掉结尾的
pub fn trim_prefix(s: str, p: str) -> str { if starts_with(s, p) { slice(s, len(p), len(s)) } else { s } }

pub fn trim_suffix(s: str, p: str) -> str { if ends_with(s, p) { slice(s, 0, len(s) - len(p)) } else { s } }

pub fn contains(s: str, sub: str) -> bool {
    index_from(s, sub, 0) >= 0
}

// 在第一个 sep 处切成两半（都不含 sep）；没有 sep 时是 None：
//   k, v = str.cut("name=云雀", "=") ?? ("", "")
pub fn cut(s: str, sep: str) -> (str, str)? {
    i = index_from(s, sep, 0)
    if i < 0 { return None }
    Some((slice(s, 0, i), slice(s, i + len(sep), len(s))))
}

// 最多切成 n 段，最后一段是剩下的全部（n <= 0 时不限）：split_n("a:b:c", ":", 2) 是 ["a", "b:c"]
pub fn split_n(s: str, sep: str, n: int) -> [str] {
    if n <= 0 { return split(s, sep) }
    out: [str] = []
    if len(sep) == 0 {
        out.push(s)
        return out
    }
    start = 0
    i = index_from(s, sep, 0)
    for i >= 0 && len(out) < n - 1 {
        out.push(slice(s, start, i))
        start = i + len(sep)
        i = index_from(s, sep, start)
    }
    out.push(slice(s, start, len(s)))
    out
}

pub fn repeat(s: str, n: int) -> str {
    out = ""
    if n <= 0 { return out }
    for _i in 0..n { out += s }
    out
}

// 把所有不重叠的 pat 换成 rep（从左到右）；pat 为空时原样返回
pub fn replace_all(s: str, pat: str, rep: str) -> str {
    n = len(pat)
    if n == 0 { return s }
    i = index_from(s, pat, 0)
    if i < 0 { return s }
    out = ""
    start = 0
    for i >= 0 {
        out += slice(s, start, i)
        out += rep
        start = i + n
        i = index_from(s, pat, start)
    }
    out + slice(s, start, len(s))
}

// 只转换 ASCII 字母，其它字节（包括中文）原样保留。在字节缓冲上改，只分配一次
pub fn to_upper(s: str) -> str {
    bs = s.to_bytes()
    for i in 0..len(bs) {
        b = bs[i]
        if b >= 'a' && b <= 'z' { bs[i] = b & 0xDF }
    }
    from_bytes(bs)
}

pub fn to_lower(s: str) -> str {
    bs = s.to_bytes()
    for i in 0..len(bs) {
        b = bs[i]
        if b >= 'A' && b <= 'Z' { bs[i] = b | 0x20 }
    }
    from_bytes(bs)
}

// 左边补 fill，直到长度（字节数）不少于 width；fill 为空时原样返回。fill 不止一个字节时可能超过 width：
// pad_start("x", 4, "ab") 是 "ababx"（5 个字节，和 Python 的 rjust 一样不截断）；要定长请用单字节的 fill

pub fn pad_start(s: str, width: int, fill: str) -> str {
    if len(fill) == 0 { return s }
    pre = ""
    for len(pre) + len(s) < width { pre += fill }
    pre + s
}

pub fn pad_end(s: str, width: int, fill: str) -> str {
    if len(fill) == 0 { return s }
    out = s.copy()
    for len(out) < width { out += fill }
    out
}

// 按 \n 切成行；末尾的换行不产生空行。行尾的 \r 留着（"a\r\nb" 是 ["a\r", "b"]），这和 io.read_line 去掉 \r 不一样；
// CRLF 的文本先 replace_all(s, "\r\n", "\n")
pub fn lines(s: str) -> [str] {
    parts = split(s, "\n")
    if len(parts) > 0 && parts[len(parts) - 1] == "" {
        _dropped = parts.pop()
    }
    parts
}
