// Lark 标准库 · 摘要和校验和（用 Lark 自己写）
// 用法：import "std/digest"
//
//   digest.sha256(bytes) -> [u8]（32 字节）     digest.to_hex(digest.sha256("abc".to_bytes())) -> "ba7816bf…"
//   digest.sha1(bytes) -> [u8]（20 字节）           digest.sha512(bytes) -> [u8]（64 字节）
//   digest.hmac_sha256(key, msg) -> [u8]           还有 hmac_sha1、hmac_sha512；别的摘要用 digest.hmac(h, 块长, key, msg)
//   digest.equal(mac1, mac2) -> bool               比较 MAC 用它（耗时和内容无关），不要用 ==
//   digest.crc32(bytes) -> int（zlib、gzip、png 用的那种）
//   digest.to_hex(bytes) -> "0a1b…"               digest.from_hex("0a1b")? -> [u8]（长度是奇数或有非十六进制字符时返回错误）
//
// SHA-1 只为了和 git 这类老格式兼容，新的用途请用 SHA-256。32 位的字放在 int 的低 32 位里，每步运算后 & M。
// 名字不叫 std/hash：hash 是 Hash 接口的协议函数（hash(k)），模块同名会分不清。

import "bytes"

const M = 0xFFFF_FFFF

fn rol(x: int, n: int) -> int { ((x << n) | (x >>> (32 - n))) & M }

fn ror(x: int, n: int) -> int { ((x >>> n) | (x << (32 - n))) & M }

// 补位：0x80，若干个 0，最后是消息的位数（大端），总长是块长的倍数。
// SHA-1 / SHA-256 的块是 64 字节、位数占 8 字节；SHA-512 的块是 128 字节、位数占 16 字节（高 8 字节是 0）
fn padded(data: [u8], blk: int) -> [u8] {
    n = len(data)
    w = blk / 8
    msg: [u8] = []
    msg.reserve((n + 1 + w + blk - 1) / blk * blk)
    for b in data { msg.push(b) }
    msg.push(0x80)
    for len(msg) % blk != blk - w { msg.push(0) }
    if w == 16 { bytes.push_u64_be(&msg, 0) }
    bytes.push_u64_be(&msg, n * 8)
    msg
}

fn push_words(inout out: [u8], hs: [int]) {
    for h in hs { bytes.push_u32_be(&out, h) }
}

pub fn sha1(data: [u8]) -> [u8] {
    msg = padded(data, 64)
    h0 = 0x6745_2301
    h1 = 0xEFCD_AB89
    h2 = 0x98BA_DCFE
    h3 = 0x1032_5476
    h4 = 0xC3D2_E1F0
    w: [int] = []
    for _i in 0..80 { w.push(0) }
    chunk = 0
    for chunk < len(msg) {
        for t in 0..16 { w[t] = bytes.u32_be(msg, chunk + t * 4) }
        for t in 16..80 { w[t] = rol(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1) }
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        for t in 0..80 {
            f = 0
            k = 0
            if t < 20 {
                f = (b & c) | ((!b & M) & d)
                k = 0x5A82_7999
            } else if t < 40 {
                f = b ^ c ^ d
                k = 0x6ED9_EBA1
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1B_BCDC
            } else {
                f = b ^ c ^ d
                k = 0xCA62_C1D6
            }
            tmp = (rol(a, 5) + f + e + k + w[t]) & M
            e = d
            d = c
            c = rol(b, 30)
            b = a
            a = tmp
        }
        h0 = (h0 + a) & M
        h1 = (h1 + b) & M
        h2 = (h2 + c) & M
        h3 = (h3 + d) & M
        h4 = (h4 + e) & M
        chunk += 64
    }
    out: [u8] = []
    push_words(&out, [h0, h1, h2, h3, h4])
    out
}

fn sha256_k() -> [int] {
    [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
}

pub fn sha256(data: [u8]) -> [u8] {
    msg = padded(data, 64)
    kk = sha256_k()
    hs = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    w: [int] = []
    for _i in 0..64 { w.push(0) }
    chunk = 0
    for chunk < len(msg) {
        for t in 0..16 { w[t] = bytes.u32_be(msg, chunk + t * 4) }
        for t in 16..64 {
            x = w[t - 15]
            y = w[t - 2]
            s0 = ror(x, 7) ^ ror(x, 18) ^ (x >>> 3)
            s1 = ror(y, 17) ^ ror(y, 19) ^ (y >>> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & M
        }
        a = hs[0]
        b = hs[1]
        c = hs[2]
        d = hs[3]
        e = hs[4]
        f = hs[5]
        g = hs[6]
        h = hs[7]
        for t in 0..64 {
            big1 = ror(e, 6) ^ ror(e, 11) ^ ror(e, 25)
            ch = (e & f) ^ ((!e & M) & g)
            t1 = (h + big1 + ch + kk[t] + w[t]) & M
            big0 = ror(a, 2) ^ ror(a, 13) ^ ror(a, 22)
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = (big0 + maj) & M
            h = g
            g = f
            f = e
            e = (d + t1) & M
            d = c
            c = b
            b = a
            a = (t1 + t2) & M
        }
        hs[0] = (hs[0] + a) & M
        hs[1] = (hs[1] + b) & M
        hs[2] = (hs[2] + c) & M
        hs[3] = (hs[3] + d) & M
        hs[4] = (hs[4] + e) & M
        hs[5] = (hs[5] + f) & M
        hs[6] = (hs[6] + g) & M
        hs[7] = (hs[7] + h) & M
        chunk += 64
    }
    out: [u8] = []
    push_words(&out, hs)
    out
}

// SHA-512 的字是 64 位，正好是一个 int：加法用回绕的 +%，右移用 >>>，常量超过 2^63 的按补码存成负数
fn ror64(x: int, n: int) -> int { (x >>> n) | (x << (64 - n)) }

fn sha512_k() -> [int] {
    [0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
        0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
        0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
        0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
        0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
        0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
        0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
        0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817]
}

pub fn sha512(data: [u8]) -> [u8] {
    msg = padded(data, 128)
    kk = sha512_k()
    hs = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179]
    w: [int] = []
    for _i in 0..80 { w.push(0) }
    chunk = 0
    for chunk < len(msg) {
        for t in 0..16 { w[t] = bytes.u64_be(msg, chunk + t * 8) }
        for t in 16..80 {
            x = w[t - 15]
            y = w[t - 2]
            s0 = ror64(x, 1) ^ ror64(x, 8) ^ (x >>> 7)
            s1 = ror64(y, 19) ^ ror64(y, 61) ^ (y >>> 6)
            w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
        }
        a = hs[0]
        b = hs[1]
        c = hs[2]
        d = hs[3]
        e = hs[4]
        f = hs[5]
        g = hs[6]
        h = hs[7]
        for t in 0..80 {
            big1 = ror64(e, 14) ^ ror64(e, 18) ^ ror64(e, 41)
            ch = (e & f) ^ (!e & g)
            t1 = h +% big1 +% ch +% kk[t] +% w[t]
            big0 = ror64(a, 28) ^ ror64(a, 34) ^ ror64(a, 39)
            maj = (a & b) ^ (a & c) ^ (b & c)
            t2 = big0 +% maj
            h = g
            g = f
            f = e
            e = d +% t1
            d = c
            c = b
            b = a
            a = t1 +% t2
        }
        hs[0] = hs[0] +% a
        hs[1] = hs[1] +% b
        hs[2] = hs[2] +% c
        hs[3] = hs[3] +% d
        hs[4] = hs[4] +% e
        hs[5] = hs[5] +% f
        hs[6] = hs[6] +% g
        hs[7] = hs[7] +% h
        chunk += 128
    }
    out: [u8] = []
    for x in hs { bytes.push_u64_be(&out, x) }
    out
}

// HMAC（RFC 2104）：h 是摘要函数，blk 是它的块长（SHA-1 / SHA-256 是 64，SHA-512 是 128）。
// 一般用下面三个现成的；比较两个 MAC 用 equal，不要用 ==
pub fn hmac(h: fn([u8]) -> [u8], blk: int, key: [u8], msg: [u8]) -> [u8] {
    k = if len(key) > blk { h(key) } else { key.copy() }
    inner: [u8] = []
    inner.reserve(blk + len(msg))
    outer: [u8] = []
    for i in 0..blk {
        b = if i < len(k) { k[i].to_int() } else { 0 }
        inner.push((b ^ 0x36).wrap_u8())
        outer.push((b ^ 0x5c).wrap_u8())
    }
    for b in msg { inner.push(b) }
    for b in h(inner) { outer.push(b) }
    h(outer)
}

pub fn hmac_sha1(key: [u8], msg: [u8]) -> [u8] { hmac(|d| sha1(d), 64, key, msg) }

pub fn hmac_sha256(key: [u8], msg: [u8]) -> [u8] { hmac(|d| sha256(d), 64, key, msg) }

pub fn hmac_sha512(key: [u8], msg: [u8]) -> [u8] { hmac(|d| sha512(d), 128, key, msg) }

// 两个字节串是否相同，用的时间只和长度有关、和内容无关（比较 MAC 时防止按耗时一个字节一个字节地猜）
pub fn equal(a: [u8], b: [u8]) -> bool {
    if len(a) != len(b) { return false }
    diff = 0
    for i in 0..len(a) { diff = diff | (a[i].to_int() ^ b[i].to_int()) }
    diff == 0
}

// CRC-32（IEEE 802.3，反射的多项式 0xEDB88320），结果在 0..2^32
pub fn crc32(data: [u8]) -> int {
    c = M
    if len(data) < 512 {
        // 短的逐位算，省得先建表
        for b in data {
            c = c ^ b.to_int()
            for _k in 0..8 {
                c = if (c & 1) != 0 { (c >>> 1) ^ 0xEDB8_8320 } else { c >>> 1 }
            }
        }
        return c ^ M
    }
    // 长的查表，一个字节一次（比逐位快 5 倍以上）
    t = crc_table()
    for b in data { c = t[(c ^ b.to_int()) & 0xFF] ^ (c >>> 8) }
    c ^ M
}

// 每个字节值逐位算 8 次的结果
fn crc_table() -> [int] {
    t: [int] = []
    t.reserve(256)
    for n in 0..256 {
        c = n
        for _k in 0..8 {
            c = if (c & 1) != 0 { (c >>> 1) ^ 0xEDB8_8320 } else { c >>> 1 }
        }
        t.push(c)
    }
    t
}

const HEX = "0123456789abcdef"

pub fn to_hex(d: [u8]) -> str {
    out: [u8] = []
    out.reserve(len(d) * 2)
    for b in d {
        n = b.to_int()
        out.push(byte_at(HEX, n / 16).wrap_u8())
        out.push(byte_at(HEX, n % 16).wrap_u8())
    }
    from_bytes(out)
}

fn hex_val(c: int) -> int {
    if c >= '0' && c <= '9' { return c - '0' }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10 }
    -1
}

// 十六进制字符串换回字节（大小写都行）；长度是奇数、有不是十六进制的字符时返回错误，信息写明第几个字符
pub fn from_hex(s: str) -> [u8]! {
    if len(s) % 2 != 0 { return Err("十六进制：长度 #{len(s)} 是奇数") }
    out: [u8] = []
    out.reserve(len(s) / 2)
    i = 0
    for i < len(s) {
        hi = hex_val(byte_at(s, i))
        lo = hex_val(byte_at(s, i + 1))
        if hi < 0 { return Err("十六进制 第 #{i + 1} 个字符：不是十六进制数字") }
        if lo < 0 { return Err("十六进制 第 #{i + 2} 个字符：不是十六进制数字") }
        out.push((hi * 16 + lo).wrap_u8())
        i += 2
    }
    Ok(out)
}
