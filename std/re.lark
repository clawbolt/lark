// Lark 标准库 · 正则表达式（用 Lark 自己写，来自 apps/lgrep）。按字节匹配（UTF-8 的中文按字节原样比较，所以字面量照样能搜）
// 用法：import "std/re"；r = re.compile("[0-9]+")?，忽略大小写写成 re.compile("(?i)hello")?
//   re.is_match(r, s)、re.find_at(r, s, 起点) -> (开始, 结束)?、re.find_all(r, s) -> [(开始, 结束)]、re.replace_all(r, s, 换成)、re.split(r, s)
//   分组：re.captures(r, s) -> [str]?（第 0 项是整个匹配，第 k 项是第 k 个括号）、re.captures_at(r, s, 起点) -> [(开始, 结束)]?
//   带 _in 的（find_in、is_match_in）只看 s 的一段，给一行行扫大段文字用：忽略大小写时 s 要先用 re.casefold(r, s) 整段转一次，其余函数自己转
//   一行行扫很多段时先 m = re.matcher(r)，再 re.is_match_in(&m, …)、re.find_in(&m, …)：线程表不用每次重新分配
//
//   (?i)       只能写在最前面：整个模式忽略大小写
//   abc        字面量；\ 转义下一个字节（\. \* \( \{ \\ 等），\t \n \r 是制表符、换行、回车
//   .          任意一个字节
//   [abc] [a-z0-9_] [^…]   字符类；里面也能写 \d \w \s
//   \d \w \s   数字、字母数字下划线、空白；大写的 \D \W \S 取反
//   x* x+ x?   零次以上、一次以上、零或一次；x{m} x{m,} x{m,n} 指定次数（最多 1000）。都是贪心的，后面再加 ? 变成非贪心（x*? x{2,5}?）
//   (x) (?:x)  分组：前一种记下匹配的位置（从 1 开始数），后一种只是括起来
//   ^ $        这一段（整个字符串，或者 find_in 给的那一段）的开头、结尾
//   a|b        几个选项，按写的顺序，靠前的优先（和 Go、Rust、Perl 一样；grep -E 取最长的那个）
//
// 不支持：反向引用（\1）、\b、命名分组、(?i) 以外的标志。忽略大小写只管 ASCII 字母。
// 实现是 Pike VM（模式编译成指令，所有可能的匹配一起往前走一个字节），时间和 文字长度 × 模式长度 成正比，
// 不会因为 (a*)*b 这样的写法变成指数时间，所以可以拿来匹配网络上来的输入。
import "std/str"

// ---------- 语法树 ----------

enum Node {
    ByteLit(b: int)
    AnyByte
    ByteSet(neg: bool, ranges: [int])   // ranges 两两一组：[lo, hi, lo, hi, …]
    LineStart
    LineEnd
    Seq(items: [Node])
    Choice(items: [Node])
    Repeat(items: [Node], min: int, max: int, greedy: bool)   // items 正好一项；max 是 -1 表示不限
    Group(items: [Node], n: int)                               // items 正好一项；第 n 个分组
}

// ---------- 指令 ----------

const OP_BYTE = 0     // x 是要的字节
const OP_ANY = 1
const OP_SET = 2      // x 是 cls 里这个字符类的起点（256 项）
const OP_SPLIT = 3    // 先走 x，再走 y（x 优先）
const OP_JMP = 4      // 跳到 x
const OP_SAVE = 5     // 把当前位置记进第 x 个位置槽
const OP_BOL = 6
const OP_EOL = 7
const OP_MATCH = 8

const MAX_REPEAT = 1000
const MAX_PROG = 20_000
const MAX_DEPTH = 1000     // 括号最多套几层（Go 的 regexp 也是 1000）：模式是外部输入，套得太深要报错，不能把栈用完

pub type Re {
    op: [int]       // 指令，和 ax、ay 一一对应
    ax: [int]
    ay: [int]
    cls: [bool]     // 所有字符类，每个 256 项
    pub groups: int // 括号分组的个数（不算 (?:…)）；模块外只读
    pub fold: bool  // 忽略大小写：模式里的字母都转成小写了，被搜的文字也要先转（见 casefold）
    first: [bool]   // 256 项：匹配能以哪些字节开头。没有线程在跑时，开不了头的位置直接跳过
    empty: bool     // 这三项见 starts：能不能不吃字节就匹配上、能不能在段尾匹配上、是不是只能从段首开头
    at_end: bool
    anchored: bool
    src: str        // 编译时的原文（含 (?i)），show 用
}

pub fn compile(pat0: str) -> Re! {
    fold = str.starts_with(pat0, "(?i)")
    off = if fold { 4 } else { 0 }
    ps = Pat(p: pat0.copy(), i: off, fold: fold, ncap: 0, depth: 0)
    tree = parse_alt(&ps)?
    if ps.i < len(ps.p) { return Err("多了一个 )（第 #{ps.i + 1} 个字节）") }
    g = Gen(op: [], ax: [], ay: [], cls: [])
    put(&g, OP_SAVE, 0, 0)
    gen(&g, tree)?
    put(&g, OP_SAVE, 1, 0)
    put(&g, OP_MATCH, 0, 0)
    st = starts(g)
    Ok(Re(op: replace(&g.op, []), ax: replace(&g.ax, []), ay: replace(&g.ay, []), cls: replace(&g.cls, []), groups: ps.ncap, fold: fold, first: replace(&st.first, []), empty: st.empty, at_end: st.at_end, anchored: st.anchored, src: pat0.copy()))
}

// ---------- 解析 ----------

type Pat {
    p: str
    i: int          // 下一个要看的字节
    fold: bool
    ncap: int       // 已经见过几个 (
    depth: int      // 现在在几层括号里
}

fn at_end(ps: Pat) -> bool { ps.i >= len(ps.p) }

fn peek(ps: Pat) -> int { byte_at(ps.p, ps.i) }

// a|b|c
fn parse_alt(inout ps: Pat) -> Node! {
    items: [Node] = [parse_seq(&ps)?]
    for !at_end(ps) && peek(ps) == '|' {
        ps.i += 1
        items.push(parse_seq(&ps)?)
    }
    Ok(Choice(items))
}

// 一串连着的项，到 |、) 或者模式结尾为止
fn parse_seq(inout ps: Pat) -> Node! {
    items: [Node] = []
    for !at_end(ps) && peek(ps) != '|' && peek(ps) != ')' {
        at = ps.i
        c = peek(ps)
        if c == '*' || c == '+' || c == '?' || is_counts(ps) { return Err("#{from_byte(c)} 前面没有可以重复的东西（第 #{at + 1} 个字节）") }
        a = parse_atom(&ps)?
        min, max, ok = parse_quant(&ps)?
        if !ok {
            items.push(a)
            continue
        }
        anchor = match a {
            LineStart => true
            LineEnd => true
            _ => false
        }
        if anchor { return Err("^ 和 $ 后面不能跟重复（第 #{at + 2} 个字节）") }
        greedy = true
        if !at_end(ps) && peek(ps) == '?' {
            greedy = false
            ps.i += 1
        }
        if !at_end(ps) && (peek(ps) == '*' || peek(ps) == '+' || peek(ps) == '?' || is_counts(ps)) {
            return Err("重复后面又跟了 #{from_byte(peek(ps))}（第 #{ps.i + 1} 个字节）；要重复一个重复，先用 (?:…) 括起来")
        }
        items.push(Repeat([a], min, max, greedy))
    }
    Ok(Seq(items))
}

// 跟在一项后面的 * + ? {m,n}：(至少几次, 最多几次（-1 不限）, 有没有)
fn parse_quant(inout ps: Pat) -> (int, int, bool)! {
    if at_end(ps) { return Ok((0, 0, false)) }
    c = peek(ps)
    if c == '*' || c == '+' || c == '?' {
        ps.i += 1
        if c == '*' { return Ok((0, -1, true)) }
        if c == '+' { return Ok((1, -1, true)) }
        return Ok((0, 1, true))
    }
    if !is_counts(ps) { return Ok((0, 0, false)) }
    at = ps.i
    ps.i += 1
    min = read_num(&ps)
    max = min
    if peek(ps) == ',' {
        ps.i += 1
        max = if peek(ps) == '}' { -1 } else { read_num(&ps) }
    }
    ps.i += 1   // }
    if min > MAX_REPEAT || max > MAX_REPEAT { return Err("重复次数最多 #{MAX_REPEAT}（第 #{at + 1} 个字节）") }
    if max >= 0 && max < min { return Err("{#{min},#{max}} 的次数反了（第 #{at + 1} 个字节）") }
    Ok((min, max, true))
}

// 当前位置是不是 {m}、{m,}、{m,n}（别的 { 当普通字节，和 Go 一样）
fn is_counts(ps: Pat) -> bool {
    p = ps.p
    i = ps.i
    if i >= len(p) || byte_at(p, i) != '{' { return false }
    i += 1
    j = digits_end(p, i)
    if j == i { return false }
    if j < len(p) && byte_at(p, j) == ',' { j = digits_end(p, j + 1) }
    j < len(p) && byte_at(p, j) == '}'
}

fn digits_end(p: str, i0: int) -> int {
    i = i0
    for i < len(p) && byte_at(p, i) >= '0' && byte_at(p, i) <= '9' { i += 1 }
    i
}

// 读一串数字；太大时停在比 MAX_REPEAT 大的值上，由调用的地方报错
fn read_num(inout ps: Pat) -> int {
    v = 0
    for !at_end(ps) && peek(ps) >= '0' && peek(ps) <= '9' {
        if v <= MAX_REPEAT { v = v * 10 + (peek(ps) - '0') }
        ps.i += 1
    }
    v
}

fn parse_atom(inout ps: Pat) -> Node! {
    at = ps.i
    c = peek(ps)
    if c == '(' {
        ps.i += 1
        n = -1
        if !at_end(ps) && peek(ps) == '?' {
            if ps.i + 1 < len(ps.p) && byte_at(ps.p, ps.i + 1) == ':' {
                ps.i += 2
            } else if str.starts_with(slice(ps.p, ps.i, len(ps.p)), "?i)") {
                return Err("(?i) 只能写在最前面（第 #{at + 1} 个字节）")
            } else {
                return Err("不支持 (? 这种写法，只有 (?:…) 和最前面的 (?i)（第 #{at + 1} 个字节）")
            }
        } else {
            ps.ncap += 1
            n = ps.ncap
        }
        ps.depth += 1
        if ps.depth > MAX_DEPTH { return Err("括号套得太深，最多 #{MAX_DEPTH} 层（第 #{at + 1} 个字节）") }
        inner = parse_alt(&ps)?
        ps.depth -= 1
        if at_end(ps) { return Err("( 没有配对的 )（第 #{at + 1} 个字节）") }
        ps.i += 1
        if n < 0 { return Ok(inner) }
        return Ok(Group([inner], n))
    }
    if c == '[' {
        a, j = parse_class(ps.p, at, len(ps.p), ps.fold)?
        ps.i = j
        return Ok(a)
    }
    ps.i += 1
    if c == '.' { return Ok(AnyByte) }
    if c == '^' { return Ok(LineStart) }
    if c == '$' { return Ok(LineEnd) }
    if c == '\\' {
        if at_end(ps) { return Err("模式以 \\ 结尾") }
        e = peek(ps)
        ps.i += 1
        rs = class_escape(e)
        if len(rs) > 0 { return Ok(ByteSet(e >= 'A' && e <= 'Z', rs)) }
        return Ok(ByteLit(lower_b(escaped_byte(e), ps.fold)))
    }
    Ok(ByteLit(lower_b(c, ps.fold)))
}

fn lower_b(c: int, fold: bool) -> int { if fold && c >= 'A' && c <= 'Z' { c + 32 } else { c } }

fn word_ranges() -> [int] { ['a', 'z', 'A', 'Z', '0', '9', '_', '_'] }

fn space_ranges() -> [int] { [' ', ' ', 9, 13] }

// \d \w \s 这类：返回它们的范围；不是时返回空列表
fn class_escape(e: int) -> [int] {
    if e == 'd' || e == 'D' { return ['0', '9'] }
    if e == 'w' || e == 'W' { return word_ranges() }
    if e == 's' || e == 'S' { return space_ranges() }
    []
}

fn escaped_byte(e: int) -> int { if e == 't' { 9 } else if e == 'n' { 10 } else if e == 'r' { 13 } else { e } }

// [ 从 i 开始；返回字符类和 ] 后面的位置
fn parse_class(p: str, i: int, n: int, fold: bool) -> (Node, int)! {
    j = i + 1
    neg = j < n && byte_at(p, j) == '^'
    if neg { j += 1 }
    rs: [int] = []
    first = true
    for true {
        if j >= n { return Err("[ 没有配对的 ]") }
        c = byte_at(p, j)
        if c == ']' && !first { break }
        first = false
        lo = c
        if c == '\\' {
            if j + 1 >= n { return Err("[ 没有配对的 ]") }
            e = byte_at(p, j + 1)
            es = class_escape(e)
            if len(es) > 0 && e >= 'a' {
                for r in es { rs.push(r) }
                j += 2
                continue
            }
            lo = escaped_byte(e)
            j += 1
        }
        j += 1
        hi = lo
        if j + 1 < n && byte_at(p, j) == '-' && byte_at(p, j + 1) != ']' {
            hi = byte_at(p, j + 1)
            j += 2
        }
        if hi < lo { return Err("字符类里的范围 #{from_byte(lo)}-#{from_byte(hi)} 反了") }
        rs.push(lo)
        rs.push(hi)
        // 忽略大小写：范围里的大写字母也放一份小写的进去（被搜的文字已经转成小写）
        if fold && lo <= 'Z' && hi >= 'A' {
            ulo = if lo > 'A' { lo } else { 'A' }
            uhi = if hi < 'Z' { hi } else { 'Z' }
            rs.push(ulo + 32)
            rs.push(uhi + 32)
        }
    }
    Ok((ByteSet(neg, rs), j + 1))
}

// ---------- 编译成指令 ----------

type Gen {
    op: [int]
    ax: [int]
    ay: [int]
    cls: [bool]
}

fn emit(inout g: Gen, op: int, x: int, y: int) -> int {
    g.op.push(op)
    g.ax.push(x)
    g.ay.push(y)
    len(g.op) - 1
}

fn put(inout g: Gen, op: int, x: int, y: int) {
    g.op.push(op)
    g.ax.push(x)
    g.ay.push(y)
}

fn here(g: Gen) -> int { len(g.op) }

fn gen(inout g: Gen, nd: Node) -> ()! {
    if len(g.op) > MAX_PROG { return Err("模式展开以后太大（{m,n} 套得太多）") }
    match nd {
        ByteLit(b) => { put(&g, OP_BYTE, b, 0) }
        AnyByte => { put(&g, OP_ANY, 0, 0) }
        ByteSet(neg, rs) => {
            at = len(g.cls)
            for c in 0..256 {
                inr = false
                k = 0
                for k < len(rs) {
                    if c >= rs[k] && c <= rs[k + 1] { inr = true }
                    k += 2
                }
                g.cls.push(inr != neg)
            }
            put(&g, OP_SET, at, 0)
        }
        LineStart => { put(&g, OP_BOL, 0, 0) }
        LineEnd => { put(&g, OP_EOL, 0, 0) }
        Seq(items) => {
            for it in items { gen(&g, it)? }
        }
        Choice(items) => {
            // SPLIT 下一项, 下一个 SPLIT；每一项后面 JMP 到最后
            jumps: [int] = []
            for k in 0..len(items) {
                if k + 1 < len(items) {
                    sp = emit(&g, OP_SPLIT, 0, 0)
                    g.ax[sp] = sp + 1
                    gen(&g, items[k])?
                    jumps.push(emit(&g, OP_JMP, 0, 0))
                    nxt = here(g)
                    g.ay[sp] = nxt
                } else {
                    gen(&g, items[k])?
                }
            }
            out = here(g)
            for j in jumps { g.ax[j] = out }
        }
        Group(items, n) => {
            put(&g, OP_SAVE, 2 * n, 0)
            gen(&g, items[0])?
            put(&g, OP_SAVE, 2 * n + 1, 0)
        }
        Repeat(items, min, max, greedy) => { gen_repeat(&g, items[0], min, max, greedy)? }
    }
    Ok()
}

// 先写 min 遍，再按 max 补：不限时是一个循环，否则是 max - min 个可以跳过的副本
fn gen_repeat(inout g: Gen, x: Node, min: int, max: int, greedy: bool) -> ()! {
    if max < 0 && min > 0 {
        // x{m,}：前 m - 1 遍照写，最后一遍写成 x+（L: x; SPLIT L, 出口）
        before = min - 1
        for _ in 0..before { gen(&g, x)? }
        top = here(g)
        gen(&g, x)?
        sp = emit(&g, OP_SPLIT, 0, 0)
        out = here(g)
        split_to(&g, sp, top, out, greedy)
        return Ok()
    }
    for _ in 0..min { gen(&g, x)? }
    if max < 0 {
        // x*：L: SPLIT 进去, 出口; x; JMP L
        top = emit(&g, OP_SPLIT, 0, 0)
        gen(&g, x)?
        put(&g, OP_JMP, top, 0)
        out = here(g)
        split_to(&g, top, top + 1, out, greedy)
        return Ok()
    }
    // x{m,n}：剩下的 n - m 遍，每遍前面一个 SPLIT，不进去就直接跳到最后
    splits: [int] = []
    for _ in min..max {
        splits.push(emit(&g, OP_SPLIT, 0, 0))
        gen(&g, x)?
    }
    out = here(g)
    for sp in splits { split_to(&g, sp, sp + 1, out, greedy) }
    Ok()
}

// 贪心时先走 more（再来一遍），非贪心时先走 out（到此为止）
fn split_to(inout g: Gen, sp: int, more: int, out: int, greedy: bool) {
    g.ax[sp] = if greedy { more } else { out }
    g.ay[sp] = if greedy { out } else { more }
}

// 从第 0 条指令出发、不吃字节能走到的地方，用来跳过不可能开头的位置：
//   first     能吃哪些字节开头
//   empty     不吃字节、也不经过 $ 就能匹配上：哪个位置都可能开头
//   at_end    不吃字节、经过 $ 能匹配上：段尾也要试一次
//   anchored  每条路在吃字节之前都先经过 ^：只有段首能开头
// ^ 在这里当成总能过，只会多试几个位置，不会漏
type Starts {
    first: [bool]
    empty: bool
    at_end: bool
    anchored: bool
}

fn starts(g: Gen) -> Starts {
    st = Starts(first: [], empty: false, at_end: false, anchored: true)
    for _ in 0..256 { st.first.push(false) }
    n = len(g.op)
    // 状态是 (指令, 经过 $ 没有)：seen[pc] 和 seen[n + pc]
    seen: [bool] = []
    for _ in 0..2 * n { seen.push(false) }
    stack = [0]
    for len(stack) > 0 {
        sv = stack.pop()
        pc = sv % n
        eol = sv >= n
        if seen[sv] { continue }
        seen[sv] = true
        o = g.op[pc]
        if o == OP_BYTE {
            st.first[g.ax[pc]] = true
        } else if o == OP_ANY {
            for b in 0..256 { st.first[b] = true }
        } else if o == OP_SET {
            for b in 0..256 {
                if g.cls[g.ax[pc] + b] { st.first[b] = true }
            }
        } else if o == OP_SPLIT {
            stack.push(g.ay[pc] + sv - pc)
            stack.push(g.ax[pc] + sv - pc)
        } else if o == OP_JMP {
            stack.push(g.ax[pc] + sv - pc)
        } else if o == OP_MATCH {
            if eol { st.at_end = true } else { st.empty = true }
        } else if o == OP_EOL {
            stack.push(n + pc + 1)
        } else {
            stack.push(sv + 1)
        }
    }
    st.anchored = all_anchored(g)
    st
}

// 从第 0 条指令出发的每条路，在吃字节、$、匹配上之前都先经过 ^
fn all_anchored(g: Gen) -> bool {
    seen: [bool] = []
    for _ in 0..len(g.op) { seen.push(false) }
    stack = [0]
    for len(stack) > 0 {
        pc = stack.pop()
        if seen[pc] { continue }
        seen[pc] = true
        o = g.op[pc]
        if o == OP_SPLIT {
            stack.push(g.ay[pc])
            stack.push(g.ax[pc])
        } else if o == OP_JMP {
            stack.push(g.ax[pc])
        } else if o == OP_SAVE {
            stack.push(pc + 1)
        } else if o != OP_BOL {
            return false
        }
    }
    true
}

// 从 pos0 起第一个可能是匹配开头的位置（只看 Starts，不跑指令）；一个都没有时返回 hi + 1。
// 常见的情况（不是只能从段首开头、也不能匹配空串）是一个只查表的内层循环，lgrep 的大部分时间在这里
fn next_start(re: Re, s: str, lo: int, hi: int, pos0: int) -> int {
    if re.anchored {
        if pos0 != lo { return hi + 1 }
        ok = re.empty || (lo < hi && re.first[byte_at(s, lo)]) || (lo == hi && re.at_end)
        if ok { return lo }
        return hi + 1
    }
    if re.empty { return pos0 }
    pos = pos0
    for pos < hi && !re.first[byte_at(s, pos)] { pos += 1 }
    if pos < hi || re.at_end { pos } else { hi + 1 }
}

// ---------- 执行 ----------

// 两张线程表：当前位置的（cur）和下一个位置的。表里的线程按优先级排，靠前的优先
type Vm {
    n: int          // 指令条数
    ns: int         // 每个线程记几个位置
    pcs: [int]      // 第 t 张表从 t * n 开始，cnt[t] 个线程
    cnt: [int]
    caps: [int]     // 第 t 张表的第 k 个线程的位置从 (t * n + k) * ns 开始
    mark: [int]     // mark[t * n + pc] == gen[t]：pc 已经在第 t 张表里了
    gen: [int]
    tmp: [int]      // 正在加的线程的位置
}

// n 个 v
fn filled(n: int, v: int) -> [int] {
    out: [int] = []
    out.reserve(n)
    for _i in 0..n { out.push(v) }
    out
}

fn new_vm() -> Vm { Vm(n: -1, ns: -1, pcs: [], cnt: [0, 0], caps: [], mark: [], gen: [0, 0], tmp: []) }

// 让 vm 能跑 n 条指令、每个线程记 ns 个位置。大小没变时只清空两张表：mark 不用清，gen 加一以后旧的标记都不算了
fn prepare(inout vm: Vm, n: int, ns: int) {
    vm.cnt[0] = 0
    vm.cnt[1] = 0
    vm.gen[0] += 1
    vm.gen[1] += 1
    if vm.n == n && vm.ns == ns { return }
    vm.n = n
    vm.ns = ns
    n2 = 2 * n
    vm.pcs = filled(n2, 0)
    vm.mark = filled(n2, -1)
    vm.caps = filled(n2 * ns, -1)
    vm.tmp = filled(ns, -1)
}

// 把从 pc 出发、不吃字节能走到的线程加进第 t 张表（JMP、SPLIT、SAVE、^、$ 当场走掉，只留下要吃字节的和 MATCH）
fn add(inout vm: Vm, re: Re, t: int, pc: int, pos: int, lo: int, hi: int) {
    mi = t * vm.n + pc
    if vm.mark[mi] == vm.gen[t] { return }
    vm.mark[mi] = vm.gen[t]
    o = re.op[pc]
    if o == OP_JMP {
        add(&vm, re, t, re.ax[pc], pos, lo, hi)
    } else if o == OP_SPLIT {
        add(&vm, re, t, re.ax[pc], pos, lo, hi)
        add(&vm, re, t, re.ay[pc], pos, lo, hi)
    } else if o == OP_SAVE {
        k = re.ax[pc]
        if k < vm.ns {
            old = vm.tmp[k]
            vm.tmp[k] = pos
            add(&vm, re, t, pc + 1, pos, lo, hi)
            vm.tmp[k] = old
        } else {
            add(&vm, re, t, pc + 1, pos, lo, hi)
        }
    } else if o == OP_BOL {
        if pos == lo { add(&vm, re, t, pc + 1, pos, lo, hi) }
    } else if o == OP_EOL {
        if pos == hi { add(&vm, re, t, pc + 1, pos, lo, hi) }
    } else {
        k = vm.cnt[t]
        vm.pcs[t * vm.n + k] = pc
        base = (t * vm.n + k) * vm.ns
        for j in 0..vm.ns { vm.caps[base + j] = vm.tmp[j] }
        vm.cnt[t] = k + 1
    }
}

// 在 s 的 [lo, hi) 这一段里、从 at 开始找第一处匹配（最靠左的开头里，按优先级的那一个），
// 记下 ns 个位置（2 是整个匹配的开始和结束，2 × (groups + 1) 连分组一起）。没有匹配时返回空列表；
// quick 时找到任何一处就停（只想知道有没有，位置不一定是优先的那个）
fn run(re: Re, s: str, lo: int, hi: int, at: int, ns: int, quick: bool) -> [int] {
    vm = new_vm()
    run_vm(&vm, re, s, lo, hi, at, ns, quick)
}

// 同 run，线程表用 vm 的（Matcher 和 all 里一直用同一个，不用每次重新分配）
fn run_vm(inout vm: Vm, re: Re, s: str, lo: int, hi: int, at: int, ns: int, quick: bool) -> [int] {
    n = len(re.op)
    best: [int] = []
    if at > hi { return best }
    // 先找第一个能开头的位置，找不到就不用建线程表了（lgrep 一行行地找，大多数行在这里就结束）
    pos = next_start(re, s, lo, hi, at)
    if pos > hi { return best }
    prepare(&vm, n, ns)
    c = 0
    for pos <= hi {
        if vm.cnt[c] == 0 {
            if len(best) > 0 { break }
            // 没有线程在跑：跳到下一个能开头的位置
            pos = next_start(re, s, lo, hi, pos)
            if pos > hi { break }
        }
        b = if pos < hi { byte_at(s, pos) } else { -1 }
        // 新的开头优先级最低，排在已有的线程后面；已经找到匹配以后不再从更靠右的地方开头
        start = (!re.anchored || pos == lo) && (re.empty || (b >= 0 && re.first[b]) || (b < 0 && re.at_end))
        if len(best) == 0 && start {
            for j in 0..ns { vm.tmp[j] = -1 }
            add(&vm, re, c, 0, pos, lo, hi)
        }
        nx = 1 - c
        vm.gen[nx] += 1
        vm.cnt[nx] = 0
        for k in 0..vm.cnt[c] {
            pc = vm.pcs[c * n + k]
            o = re.op[pc]
            base = (c * n + k) * ns
            if o == OP_MATCH {
                best = []
                for j in 0..ns { best.push(vm.caps[base + j]) }
                if quick { return best }
                // 后面的线程优先级更低，不要了
                break
            }
            ok = b >= 0 && (o == OP_ANY || (o == OP_BYTE && re.ax[pc] == b) || (o == OP_SET && re.cls[re.ax[pc] + b]))
            if ok {
                for j in 0..ns { vm.tmp[j] = vm.caps[base + j] }
                add(&vm, re, nx, pc + 1, pos + 1, lo, hi)
            }
        }
        c = nx
        pos += 1
    }
    best
}

// ---------- 对外的函数 ----------

// 在 s 的 [lo, hi) 这一段里、从 at 开始找第一处匹配：(开始, 结束)。
// ^ 和 $ 指这一段的开头和结尾，所以整段文字可以一行行地找，不用把每行切出来。忽略大小写时 s 要先用 casefold 转过
pub fn find_in(re: Re, s: str, lo: int, hi: int, at: int) -> (int, int)? {
    m = run(re, s, lo, hi, at, 2, false)
    if len(m) == 0 { None } else { Some((m[0], m[1])) }
}

// s 的 [lo, hi) 这一段里有没有匹配（忽略大小写时 s 要先用 casefold 转过）
pub fn is_match_in(re: Re, s: str, lo: int, hi: int) -> bool { len(run(re, s, lo, hi, lo, 2, true)) > 0 }

// 反复在大段文字里一行行地找时用：线程表在几次匹配之间留着，不用每次重新分配（lgrep 就这样用）。
//   m = re.matcher(r)
//   for … { if re.is_match_in(&m, subj, lo, hi) { … } }
// 和 Re 版的 is_match_in、find_in 结果一样；subj 一样要先用 casefold 转过。一个 Matcher 只给一个任务用
pub type Matcher {
    re: Re
    vm: Vm
}

pub fn matcher(r: Re) -> Matcher { Matcher(re: r.copy(), vm: new_vm()) }

pub fn is_match_in(inout m: Matcher, s: str, lo: int, hi: int) -> bool {
    // 没有能开头的位置时直接返回：大多数行在这里结束，不要为它们换线程表（换一次要分配一个空的 Vm）
    if next_start(m.re, s, lo, hi, lo) > hi { return false }
    vm = replace(&m.vm, new_vm())
    r = run_vm(&vm, m.re, s, lo, hi, lo, 2, true)
    m.vm = vm
    len(r) > 0
}

pub fn find_in(inout m: Matcher, s: str, lo: int, hi: int, at: int) -> (int, int)? {
    if at > hi || next_start(m.re, s, lo, hi, at) > hi { return None }
    vm = replace(&m.vm, new_vm())
    r = run_vm(&vm, m.re, s, lo, hi, at, 2, false)
    m.vm = vm
    if len(r) == 0 { None } else { Some((r[0], r[1])) }
}

// "#{m}"：Matcher("[0-9]+")
pub fn show(m: Matcher) -> str { "Matcher" + slice(show(m.re), 2, len(show(m.re))) }

// 忽略大小写时被搜的文字要先这样转（只转 ASCII 字母，长度不变，所以位置和原文一一对应）
pub fn casefold(re: Re, s: str) -> str { if re.fold { str.to_lower(s) } else { s } }

// s 里有没有匹配（忽略大小写时自己先转小写）
pub fn is_match(r: Re, s: str) -> bool {
    subj = casefold(r, s)
    is_match_in(r, subj, 0, len(subj))
}

// 从 at 开始找第一处匹配：(开始, 结束)（忽略大小写时自己先转小写）
pub fn find_at(r: Re, s: str, at: int) -> (int, int)? {
    subj = casefold(r, s)
    find_in(r, subj, 0, len(subj), at)
}

// 从 at 开始的第一处匹配和每个分组的位置：第 0 项是整个匹配，第 k 项是第 k 个括号；
// 括号没有参与匹配时（比如 (a)|b 匹配上 b）是 (-1, -1)。分组在重复里时记最后一次
pub fn captures_at(r: Re, s: str, at: int) -> [(int, int)]? {
    subj = casefold(r, s)
    m = run(r, subj, 0, len(subj), at, 2 * (r.groups + 1), false)
    if len(m) == 0 { return None }
    Some(pairs(m))
}

// 第一处匹配和每个分组的原文（没有参与匹配的分组是 ""）：re.captures(rx("(\\w+)=(\\d+)"), "x a=1") 是 Some(["a=1", "a", "1"])
pub fn captures(r: Re, s: str) -> [str]? {
    ps = match take captures_at(r, s, 0) {
        Some(x) => x
        None => { return None }
    }
    out: [str] = []
    for (a, b) in ps {
        if a < 0 { out.push("") } else { out.push(slice(s, a, b)) }
    }
    Some(out)
}

fn pairs(m: [int]) -> [(int, int)] {
    out: [(int, int)] = []
    k = 0
    for k + 1 < len(m) {
        // 开始记过、结束没记过的分组（不会出现在匹配里），一样当没有参与
        if m[k] < 0 || m[k + 1] < 0 { out.push((-1, -1)) } else { out.push((m[k], m[k + 1])) }
        k += 2
    }
    out
}

// 所有不重叠的匹配，每个记 ns 个位置，从左到右。空的匹配（比如 x*）之后往前走一个字节
fn all(r: Re, subj: str, ns: int) -> [[int]] {
    vm = new_vm()
    out: [[int]] = []
    pos = 0
    for pos <= len(subj) {
        m = run_vm(&vm, r, subj, 0, len(subj), pos, ns, false)
        if len(m) == 0 { break }
        pos = if m[1] > m[0] { m[1] } else { m[0] + 1 }
        out.push(m)
    }
    out
}

// 所有不重叠的匹配，从左到右：[(开始, 结束)]。空的匹配（比如 x*）之后往前走一个字节
pub fn find_all(r: Re, s: str) -> [(int, int)] {
    out: [(int, int)] = []
    for m in all(r, casefold(r, s), 2) { out.push((m[0], m[1])) }
    out
}

// 把每一处匹配换成 rep。rep 里的 $1、$2 … 换成对应分组的原文（$0 是整个匹配，没有这个分组或者没参与匹配时是空的），
// $$ 是一个 $，别的 $ 原样留着
pub fn replace_all(r: Re, s: str, rep: str) -> str {
    has_ref = str.contains(rep, "$")
    ns = if has_ref { 2 * (r.groups + 1) } else { 2 }
    out = ""
    last = 0
    for m in all(r, casefold(r, s), ns) {
        out += slice(s, last, m[0])
        if has_ref { out += expand(rep, s, m) } else { out += rep }
        last = m[1]
    }
    out + slice(s, last, len(s))
}

fn expand(rep: str, s: str, m: [int]) -> str {
    out = ""
    i = 0
    for i < len(rep) {
        c = byte_at(rep, i)
        if c != '$' || i + 1 >= len(rep) {
            out += slice(rep, i, i + 1)
            i += 1
            continue
        }
        d = byte_at(rep, i + 1)
        if d == '$' {
            out += "$"
            i += 2
            continue
        }
        j = digits_end(rep, i + 1)
        if j == i + 1 {
            out += "$"
            i += 1
            continue
        }
        k = 2 * (try_parse_int(slice(rep, i + 1, j)) ?? 1_000_000)
        if k + 1 < len(m) && m[k] >= 0 && m[k + 1] >= 0 { out += slice(s, m[k], m[k + 1]) }
        i = j
    }
    out
}

// 按匹配切开（空的匹配不切）
pub fn split(r: Re, s: str) -> [str] {
    out: [str] = []
    last = 0
    for (a, b) in find_all(r, s) {
        if b > a {
            out.push(slice(s, last, a))
            last = b
        }
    }
    out.push(slice(s, last, len(s)))
    out
}

// "#{r}"：Re("[0-9]+")，括号里是编译时的原文
pub fn show(r: Re) -> str {
    q = "#{[r.src.copy()]}"
    "Re(#{slice(q, 1, len(q) - 1)})"
}
