// Lark 标准库 · 文本差异（用 Lark 自己写）
// 用法：import "std/diff"
//
//   print(diff.unified("a.txt", "b.txt", old, new))     // 像 diff -u 一样：--- / +++ 两行加上各块；两边一样时是 ""
//   h = diff.hunks(old, new)                             // 只要从 @@ 开始的部分（上下文 3 行）
//   h = diff.hunks_with(old, new, diff.Opts(context: 1, func: true))
//   ops = diff.edits(a_lines, b_lines)                   // 最短的编辑序列：diff.SAME、diff.DEL、diff.ADD
//   ls = diff.lines_with_ends(text)                                // 按行切开，每行带着自己的 \n
//
// Myers 算法（时间 O((N+M)·D)，D 是改动的行数；内存 O(D²)，改动多时换成 O(N+M) 的分治）。一段连续的改动里先列删掉的、再列加上的，和 git、GNU diff 一样。
// 最后一行没有换行时照 diff 的写法加一行 "\ No newline at end of file"。
// func 为 true 时像 git 一样在 @@ 后面带上这一块之前最近一行以字母、_ 或 $ 开头的行。

pub const SAME = 0
pub const DEL = 1
pub const ADD = 2

pub type Opts {
    pub context: int    // 每块前后带几行没改的
    pub func: bool
}

// 按行切开，每行带着自己的 \n（最后一行可能没有）
pub fn lines_with_ends(text: str) -> [str] {
    out: [str] = []
    start = 0
    for i in 0..len(text) {
        if byte_at(text, i) == '\n' {
            out.push(slice(text, start, i + 1))
            start = i + 1
        }
    }
    if start < len(text) { out.push(slice(text, start, len(text))) }
    out
}

// Myers：第 d 轮找出 d 次增删能走到的最远位置，走到终点后沿记录倒推。
// 记录是每一轮开始时 v 的副本，平铺在一个列表里（每轮 w 个数）
pub fn edits(a: [str], b: [str]) -> [int] {
    // 两头相同的行先去掉，中间才跑 Myers：只改了几行的大文件很快
    n0 = len(a)
    m0 = len(b)
    pre = 0
    for pre < n0 && pre < m0 && a[pre] == b[pre] { pre += 1 }
    suf = 0
    for suf < n0 - pre && suf < m0 - pre && a[n0 - 1 - suf] == b[m0 - 1 - suf] { suf += 1 }
    n = n0 - pre - suf
    m = m0 - pre - suf
    ops: [int] = []
    for _k in 0..pre { ops.push(SAME) }
    mx = n + m
    if mx > 0 { middle(a, b, pre, n, m, &ops) }
    for _k in 0..suf { ops.push(SAME) }
    ops
}

// 倒推用的记录最多这么多个数（32 MB）：改动多到超过时改用线性空间的分治（split_into），结果一样短，只是可能换一种对齐方式
const MAX_TRACE = 4_000_000

// a[pre, pre + n) 和 b[pre, pre + m) 之间的编辑序列，接在 ops 后面
fn middle(a: [str], b: [str], pre: int, n: int, m: int, inout ops: [int]) {
    raw: [int] = []
    if !greedy(a, b, pre, n, m, &raw) {
        raw = []
        split_into(a, b, pre, pre + n, pre, pre + m, &raw)
    }
    group_into(raw, &ops)
}

// 第 d 轮开始时只记 v[-d..d] 这 2d+1 个数，第 d 轮的记录从 d*d 开始：总共 D² 个。超过 MAX_TRACE 时放弃，返回 false
fn greedy(a: [str], b: [str], pre: int, n: int, m: int, inout raw: [int]) -> bool {
    mx = n + m
    w = 2 * mx + 3
    off = mx + 1
    v: [int] = []
    for _i in 0..w { v.push(0) }
    trace: [int] = []
    d = 0
    found = false
    for d <= mx && !found {
        if (d + 1) * (d + 1) > MAX_TRACE { return false }
        for k in (0 - d)..(d + 1) { trace.push(v[off + k]) }
        k = 0 - d
        for k <= d && !found {
            x = 0
            if k == 0 - d || (k != d && v[off + k - 1] < v[off + k + 1]) {
                x = v[off + k + 1]
            } else {
                x = v[off + k - 1] + 1
            }
            y = x - k
            for x < n && y < m && a[pre + x] == b[pre + y] {
                x += 1
                y += 1
            }
            v[off + k] = x
            if x >= n && y >= m { found = true }
            k += 2
        }
        if !found { d += 1 }
    }
    // 倒推：从终点往回，每轮先退掉斜线（相同的行），再退一步增或删
    rev: [int] = []
    cx = n
    cy = m
    dd = d
    for dd > 0 {
        base = dd * dd + dd       // 第 dd 轮的记录里 k 的位置是 base + k
        kk = cx - cy
        pk = kk - 1
        if kk == 0 - dd || (kk != dd && trace[base + kk - 1] < trace[base + kk + 1]) { pk = kk + 1 }
        px = trace[base + pk]
        py = px - pk
        for cx > px && cy > py {
            rev.push(SAME)
            cx -= 1
            cy -= 1
        }
        if cx == px {
            rev.push(ADD)
            cy -= 1
        } else {
            rev.push(DEL)
            cx -= 1
        }
        dd -= 1
    }
    for cx > 0 {
        rev.push(SAME)
        cx -= 1
    }
    i = len(rev) - 1
    for i >= 0 {
        raw.push(rev[i])
        i -= 1
    }
    true
}

// Myers 论文第 4b 节的线性空间做法：从两头同时走，在中间相遇的那段斜线（middle snake）上切开，两边分别递归。
// 每层只用 O(N+M) 的内存；两边的 D 都比原来小，所以一定会结束
fn split_into(a: [str], b: [str], a0: int, a1: int, b0: int, b1: int, inout raw: [int]) {
    lo_a = a0
    lo_b = b0
    hi_a = a1
    hi_b = b1
    for lo_a < hi_a && lo_b < hi_b && a[lo_a] == b[lo_b] {
        raw.push(SAME)
        lo_a += 1
        lo_b += 1
    }
    tail = 0
    for hi_a > lo_a && hi_b > lo_b && a[hi_a - 1] == b[hi_b - 1] {
        hi_a -= 1
        hi_b -= 1
        tail += 1
    }
    if lo_a == hi_a || lo_b == hi_b {
        for _k in lo_a..hi_a { raw.push(DEL) }
        for _k in lo_b..hi_b { raw.push(ADD) }
    } else {
        sx, sy, ex, ey = middle_snake(a, b, lo_a, hi_a, lo_b, hi_b)
        split_into(a, b, lo_a, lo_a + sx, lo_b, lo_b + sy, &raw)
        for _k in sx..ex { raw.push(SAME) }
        split_into(a, b, lo_a + ex, hi_a, lo_b + ey, hi_b, &raw)
    }
    for _k in 0..tail { raw.push(SAME) }
}

// 两边都不空、首尾都不同时，找最短编辑路径中间的一段斜线：返回它在 a[a0..)、b[b0..) 里的起点和终点（相对位置）
fn middle_snake(a: [str], b: [str], a0: int, a1: int, b0: int, b1: int) -> (int, int, int, int) {
    n = a1 - a0
    m = b1 - b0
    delta = n - m
    odd = (delta & 1) != 0
    mx = (n + m + 1) / 2 + 1
    off = mx + 1
    vf: [int] = []
    vb: [int] = []
    for _i in 0..2 * mx + 3 {
        vf.push(0)
        vb.push(0)
    }
    for d in 0..mx + 1 {
        // 从左上往右下
        k = 0 - d
        for k <= d {
            x = if k == 0 - d || (k != d && vf[off + k - 1] < vf[off + k + 1]) { vf[off + k + 1] } else { vf[off + k - 1] + 1 }
            y = x - k
            sx = x
            sy = y
            for x < n && y < m && a[a0 + x] == b[b0 + y] {
                x += 1
                y += 1
            }
            vf[off + k] = x
            kb = delta - k
            if odd && kb >= 1 - d && kb <= d - 1 && x + vb[off + kb] >= n { return (sx, sy, x, y) }
            k += 2
        }
        // 从右下往左上（x、y 是从末尾数的）
        k = 0 - d
        for k <= d {
            x = if k == 0 - d || (k != d && vb[off + k - 1] < vb[off + k + 1]) { vb[off + k + 1] } else { vb[off + k - 1] + 1 }
            y = x - k
            sx = x
            sy = y
            for x < n && y < m && a[a1 - 1 - x] == b[b1 - 1 - y] {
                x += 1
                y += 1
            }
            vb[off + k] = x
            kf = delta - k
            if !odd && kf >= 0 - d && kf <= d && x + vf[off + kf] >= n { return (n - x, m - y, n - sx, m - sy) }
            k += 2
        }
    }
    panic("diff：内部错误，没有找到中间的斜线")
}

// 一段连续的改动里先列删掉的、再列加上的
fn group_into(raw: [int], inout ops: [int]) {
    i = 0
    for i < len(raw) {
        if raw[i] == SAME {
            ops.push(SAME)
            i += 1
        } else {
            dels = 0
            adds = 0
            for i < len(raw) && raw[i] != SAME {
                if raw[i] == DEL { dels += 1 } else { adds += 1 }
                i += 1
            }
            for _k in 0..dels { ops.push(DEL) }
            for _k in 0..adds { ops.push(ADD) }
        }
    }
}

fn line_out(mark: str, ln: str) -> str {
    if len(ln) > 0 && byte_at(ln, len(ln) - 1) == '\n' { mark + ln } else { mark + ln + "\n\\ No newline at end of file\n" }
}

// @@ 里的范围：起点从 1 数；没有行时写前一行的行号；只有一行时省掉 ",1"
fn range_of(s: int, c: int) -> str {
    start = if c == 0 { s } else { s + 1 }
    if c == 1 { "#{start}" } else { "#{start},#{c}" }
}

// 这一块之前、最近一行以字母、_ 或 $ 开头的行（最多 80 个字节，去掉末尾空白）
fn func_ctx(a: [str], s: int) -> str {
    l = s - 1
    for l >= 0 {
        ln = a[l]
        if len(ln) > 0 {
            c = byte_at(ln, 0)
            if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$' {
                e = if len(ln) < 80 { len(ln) } else { 80 }
                for e > 0 && is_space(byte_at(ln, e - 1)) { e -= 1 }
                return " " + slice(ln, 0, e)
            }
        }
        l -= 1
    }
    ""
}

fn is_space(c: int) -> bool { c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12 }

pub fn hunks(old_text: str, new_text: str) -> str { hunks_with(old_text, new_text, Opts(context: 3, func: false)) }

// 统一格式的正文（从 @@ 开始）；两边一样时是 ""
pub fn hunks_with(old_text: str, new_text: str, o: Opts) -> str {
    ctx = if o.context < 0 { 0 } else { o.context }
    a = lines_with_ends(old_text)
    b = lines_with_ends(new_text)
    ops = edits(a, b)
    // 每个操作之前，两边各自走到了第几行
    ai: [int] = []
    bi: [int] = []
    x = 0
    y = 0
    for op in ops {
        ai.push(x)
        bi.push(y)
        if op != ADD { x += 1 }
        if op != DEL { y += 1 }
    }
    out = ""
    n = len(ops)
    i = 0
    for i < n {
        if ops[i] == SAME {
            i += 1
            continue
        }
        // 一块从变更 i 开始，后面的变更离得不超过 2 × 上下文就并进来
        last = i
        j = i + 1
        for j < n {
            if ops[j] != SAME {
                if j - last - 1 > 2 * ctx { break }
                last = j
            }
            j += 1
        }
        lo = if i > ctx { i - ctx } else { 0 }
        hi = if last + ctx + 1 < n { last + ctx + 1 } else { n }
        ac = 0
        bc = 0
        body = ""
        for k in lo..hi {
            if ops[k] == SAME {
                body += line_out(" ", a[ai[k]])
                ac += 1
                bc += 1
            } else if ops[k] == DEL {
                body += line_out("-", a[ai[k]])
                ac += 1
            } else {
                body += line_out("+", b[bi[k]])
                bc += 1
            }
        }
        fc = if o.func { func_ctx(a, ai[lo]) } else { "" }
        out += "@@ -#{range_of(ai[lo], ac)} +#{range_of(bi[lo], bc)} @@#{fc}\n" + body
        i = last + 1
    }
    out
}

pub fn unified(old_name: str, new_name: str, old_text: str, new_text: str) -> str {
    h = hunks(old_text, new_text)
    if h == "" { "" } else { "--- #{old_name}\n+++ #{new_name}\n" + h }
}

// "#{o}"：Opts(context: 3, func: false)，和构造它的写法一样
pub fn show(o: Opts) -> str { "Opts(context: #{o.context}, func: #{o.func})" }
