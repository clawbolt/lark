// Lark 标准库 · UTF-8（用 Lark 自己写）
// str 是字节串：len、byte_at、slice 都按字节。这个模块按字符（Unicode 码点）处理：
// 用法：import "std/utf8"
//
//   utf8.count("你好a")              // 3：字符个数（len 是 7 个字节）
//   utf8.chars("你好")               // ["你", "好"]：每个字符一个 str
//   for ch in utf8.each(s) { … }     // 逐个字符，ch 是 str，不先建列表
//   utf8.code_points("中a")                // [20013, 97]：码点
//   utf8.from_code_point(20013)            // "中"
//   utf8.slice_chars(s, 1, 3)                // 按字符下标取子串 [1, 3)，越界时截到两端
//   utf8.is_valid(s)                 // 是不是合法的 UTF-8（过长编码、代理区也算不合法）
//
// 不合法的地方（形状不对、被截断、过长编码、代理区、超过 U+10FFFF）每次只算一个字节、当一个字符，
// 码点是 U+FFFD（替换字符 REPLACEMENT），和 Go 的 utf8.DecodeRune、Rust 的 from_utf8_lossy 一样。
// 所以这些函数对任何 str 都不会 panic，code_points 给出的码点都能交给 from_code_point。

const REPLACEMENT = 0xFFFD

// 首字节 b 说明的字符长度；不能当首字节的算 1
fn char_len(b: int) -> int {
    if b < 128 {
        1
    } else if b >= 240 && b < 248 {
        4
    } else if b >= 224 {
        if b < 240 { 3 } else { 1 }
    } else if b >= 192 {
        2
    } else {
        1
    }
}

// s 里从字节 i 开始的合法字符占几个字节（RFC 3629，和 Go 的 utf8.ValidString、Rust 的 str::from_utf8 一样严）；
// 不合法时是 0：字节的形状不对、被截断，或者是过长编码（C0 80 写 NUL 这种）、代理区（U+D800..U+DFFF）、超过 U+10FFFF
fn valid_len(s: str, i: int) -> int {
    b0 = byte_at(s, i)
    if b0 < 128 { return 1 }
    k = char_len(b0)
    if k == 1 || b0 == 0xC0 || b0 == 0xC1 || b0 > 0xF4 || i + k > len(s) { return 0 }
    // 第二个字节的范围挡住过长编码（E0、F0）、代理区（ED）和太大的码点（F4）
    lo = if b0 == 0xE0 { 0xA0 } else if b0 == 0xF0 { 0x90 } else { 0x80 }
    hi = if b0 == 0xED { 0x9F } else if b0 == 0xF4 { 0x8F } else { 0xBF }
    b1 = byte_at(s, i + 1)
    if b1 < lo || b1 > hi { return 0 }
    for j in 2..k {
        b = byte_at(s, i + j)
        if b < 0x80 || b > 0xBF { return 0 }
    }
    k
}

// s 里从字节 i 开始的字符的长度：不合法时算 1 个字节
fn len_at(s: str, i: int) -> int {
    k = valid_len(s, i)
    if k == 0 { 1 } else { k }
}

pub fn count(s: str) -> int {
    k = 0
    i = 0
    for i < len(s) {
        i += len_at(s, i)
        k += 1
    }
    k
}

pub fn chars(s: str) -> [str] {
    out: [str] = []
    i = 0
    for i < len(s) {
        n = len_at(s, i)
        out.push(slice(s, i, i + n))
        i += n
    }
    out
}

// for ch in utf8.each(s)：逐个字符的迭代器
pub type Chars {
    s: str
    i: int
}

pub fn each(s: str) -> Chars { Chars(s: s, i: 0) }

pub fn next(inout it: Chars) -> str? {
    if it.i >= len(it.s) { return None }
    n = len_at(it.s, it.i)
    ch = slice(it.s, it.i, it.i + n)
    it.i += n
    Some(ch)
}

// 从字节 i 开始的字符的码点；不合法时是 U+FFFD
fn code_at(s: str, i: int) -> int {
    k = valid_len(s, i)
    b0 = byte_at(s, i)
    if k == 1 {
        b0
    } else if k == 2 {
        b0 % 32 * 64 + byte_at(s, i + 1) % 64
    } else if k == 3 {
        b0 % 16 * 4096 + byte_at(s, i + 1) % 64 * 64 + byte_at(s, i + 2) % 64
    } else if k == 4 {
        b0 % 8 * 262144 + byte_at(s, i + 1) % 64 * 4096 + byte_at(s, i + 2) % 64 * 64 + byte_at(s, i + 3) % 64
    } else {
        REPLACEMENT
    }
}

pub fn code_points(s: str) -> [int] {
    out: [int] = []
    i = 0
    for i < len(s) {
        out.push(code_at(s, i))
        i += len_at(s, i)
    }
    out
}

// 码点编码成 UTF-8；负数、代理区（0xD800..0xDFFF，UTF-8 里不能出现）和超过 0x10FFFF（1114111）的码点 panic
pub fn from_code_point(cp: int) -> str {
    if cp < 0 || cp > 1114111 || (cp >= 0xD800 && cp <= 0xDFFF) { panic("utf8.from_code_point：#{cp} 不是合法的码点") }
    if cp < 128 {
        from_byte(cp)
    } else if cp < 2048 {
        from_byte(192 + cp / 64) + from_byte(128 + cp % 64)
    } else if cp < 65536 {
        from_byte(224 + cp / 4096) + from_byte(128 + cp / 64 % 64) + from_byte(128 + cp % 64)
    } else {
        from_byte(240 + cp / 262144) + from_byte(128 + cp / 4096 % 64) + from_byte(128 + cp / 64 % 64) + from_byte(128 + cp % 64)
    }
}

// 第 k 个字符开始的字节位置（k 超过字符个数时是 len(s)）
fn byte_pos(s: str, k: int) -> int {
    i = 0
    c = 0
    for i < len(s) && c < k {
        i += len_at(s, i)
        c += 1
    }
    i
}

pub fn slice_chars(s: str, a: int, b: int) -> str {
    lo = if a < 0 { 0 } else { a }
    if b <= lo { return "" }
    i = byte_pos(s, lo)
    j = i
    c = lo
    for j < len(s) && c < b {
        j += len_at(s, j)
        c += 1
    }
    slice(s, i, j)
}

// 是不是合法的 UTF-8：每个字符都合法（见 valid_len）
pub fn is_valid(s: str) -> bool {
    i = 0
    for i < len(s) {
        k = valid_len(s, i)
        if k == 0 { return false }
        i += k
    }
    true
}
