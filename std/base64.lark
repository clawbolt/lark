// Lark 标准库 · Base64（RFC 4648，用 Lark 自己写）
// 用法：import "std/base64"
//
//   base64.encode(bytes) -> "Zm9v"            base64.decode("Zm9v")? -> [u8]
//   base64.encode_str("foo")                  base64.decode_str("Zm9v")? -> str
//   base64.encode_url(bytes) / decode_url(s)  URL 安全的字母表（- 和 _），编码时不补 =，解码时有没有 = 都行
//
// 解码很严格：有字母表以外的字符（包括空白和换行）、长度不对、= 的个数不对、最后一个字符里多出来的位不是 0 时都返回错误，
// 信息写成 “base64 第 N 个字符：原因”（和整段有关的写成 “base64：原因”）。
// 十六进制在 std/digest（digest.to_hex / digest.from_hex）。

const STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

pub fn encode(d: [u8]) -> str { enc(d, STD, true) }

pub fn decode(s: str) -> [u8]! { dec(s, false) }

pub fn encode_url(d: [u8]) -> str { enc(d, URL, false) }

pub fn decode_url(s: str) -> [u8]! { dec(s, true) }

pub fn encode_str(s: str) -> str { encode(s.to_bytes()) }

// 解出来的字节原样当作 str（不检查是不是合法的 UTF-8）
pub fn decode_str(s: str) -> str! { Ok(from_bytes(decode(s)?)) }

// 每 3 个字节变成 4 个字符；最后剩 1 或 2 个字节时出 2 或 3 个字符，pad 时再补 = 到 4 个
fn enc(d: [u8], abc: str, pad: bool) -> str {
    n = len(d)
    out: [u8] = []
    out.reserve((n + 2) / 3 * 4)
    i = 0
    for i + 3 <= n {
        v = (d[i].to_int() << 16) | (d[i + 1].to_int() << 8) | d[i + 2].to_int()
        for k in 0..4 { out.push(byte_at(abc, (v >>> (18 - k * 6)) & 63).wrap_u8()) }
        i += 3
    }
    rest = n - i
    if rest > 0 {
        v = d[i].to_int() << 16
        if rest == 2 { v = v | (d[i + 1].to_int() << 8) }
        for k in 0..rest + 1 { out.push(byte_at(abc, (v >>> (18 - k * 6)) & 63).wrap_u8()) }
        // 0x3D 是 =
        if pad {
            for _k in rest + 1..4 { out.push(0x3D) }
        }
    }
    from_bytes(out)
}

fn val(c: int, url: bool) -> int {
    if c >= 'A' && c <= 'Z' { return c - 'A' }
    if c >= 'a' && c <= 'z' { return c - 'a' + 26 }
    if c >= '0' && c <= '9' { return c - '0' + 52 }
    if url {
        if c == '-' { return 62 }
        if c == '_' { return 63 }
    } else {
        if c == '+' { return 62 }
        if c == '/' { return 63 }
    }
    -1
}

fn dec(s: str, url: bool) -> [u8]! {
    n = len(s)
    for n > 0 && byte_at(s, n - 1) == '=' { n -= 1 }
    pads = len(s) - n
    if pads > 2 { return Err("base64 第 #{n + 1} 个字符：末尾的 = 太多（最多两个）") }
    if n % 4 == 1 { return Err("base64：去掉末尾的 = 以后有 #{n} 个字符，除以 4 余 1，不可能是合法的编码") }
    // 标准写法总要补齐到 4 的倍数；URL 写法不补也行，补了就得补齐
    if (!url || pads > 0) && len(s) % 4 != 0 { return Err("base64：长度 #{len(s)} 不是 4 的倍数（要用 = 补齐）") }
    out: [u8] = []
    out.reserve(n / 4 * 3 + 2)
    acc = 0
    bits = 0
    for i in 0..n {
        v = val(byte_at(s, i), url)
        if v < 0 {
            abc = if url { "URL 安全的字母表" } else { "字母表" }
            return Err("base64 第 #{i + 1} 个字符：不在#{abc}里（字节 #{byte_at(s, i)}）")
        }
        acc = ((acc << 6) | v) & 0xFF_FFFF
        bits += 6
        if bits >= 8 {
            bits -= 8
            out.push(((acc >>> bits) & 0xFF).wrap_u8())
        }
    }
    // 剩下没凑够一个字节的位必须是 0，这样每段数据只有一种写法
    if (acc & ((1 << bits) - 1)) != 0 { return Err("base64 第 #{n} 个字符：多出来的位不是 0") }
    Ok(out)
}
