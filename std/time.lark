// Lark 标准库 · 时间（用 Lark 自己写，底下是内置的 now_ns、mono_ns、sleep_ms）
// 用法：import "std/time"
//
//   t = time.now()                          // Instant：单调时钟，只用来量时间间隔
//   …
//   ns = time.elapsed_ns(t)                 // 过了多少纳秒；time.elapsed_ms(t) 是毫秒
//   print(time.format_dur(ns))              // 人看的时长："1.5s"、"12.3ms"、"2m5s"；time.parse_dur 读回来
//   ms = time.unix_ms()                     // 从 1970-01-01 UTC 起的毫秒数（墙上时间）；time.unix_ns() 是纳秒
//   d = time.date_utc(ms)                   // Date：年月日、时分秒、毫秒、星期（0 是星期日）
//   d.format()                              // "2026-10-26 07:52:00"；d.format_iso() 是 "2026-10-26T07:52:00.123Z"
//   bj = time.date_at(ms, 8 * 60)           // 固定时差（分钟）下的日期时间，比如北京时间
//   ms2 = time.to_unix_ms(d)                // Date 转回毫秒数（按 UTC）
//   ms3 = time.parse_iso("2026-10-26T07:52:00Z")?   // int!：也接受 "2026-10-26"、带 .123 毫秒的写法
//   ns = time.parse_dur("1h30m")?           // 时长的写法：ns us µs ms s m h，可以带小数、连着写（"1.5s"、"2m30s"）
//   time.local_offset(ms)                   // 系统时区在这一刻的时差（分钟，东边为正），本地时间是 time.date_at(ms, time.local_offset(ms))
//   time.format_iso_at(ms, 8 * 60)          // "2026-10-29T12:24:01.123+08:00"；parse_iso 也认 +08:00 / -0500 这样的时差
//
// 睡一会儿用内置的 sleep_ms(毫秒)。日期按公历推算（1970 年以前也可以）。Date 本身不带时区：date_utc 是 UTC，date_at 是给定时差下的墙上时间。

extern "c" {
    fn lark_tz_offset(ms: int) -> int
}

pub type Instant {
    ns: int
}

pub type Date {
    pub year: int
    pub month: int      // 1..12
    pub day: int        // 1..31
    pub hour: int
    pub minute: int
    pub second: int
    pub ms: int
    pub weekday: int    // 0 是星期日，1 是星期一 … 6 是星期六
}

const MS_PER_DAY = 86_400_000

// ---------- 时钟 ----------

pub fn now() -> Instant { Instant(ns: mono_ns()) }

pub fn elapsed_ns(t: Instant) -> int { mono_ns() - t.ns }

pub fn elapsed_ms(t: Instant) -> int { elapsed_ns(t) / 1_000_000 }

pub fn unix_ms() -> int { now_ms() }

pub fn unix_ns() -> int { now_ns() }

// ---------- 时长 ----------

// 纳秒数写成人看的时长：不到 1 秒时用 ns / µs / ms（保留一位小数），不到 1 分钟时用 s，再往上是 1m30s、2h5m
pub fn format_dur(ns: int) -> str {
    if ns < 0 { return "-" + format_dur(0 - ns) }
    if ns < 1_000 { return "#{ns}ns" }
    if ns < 1_000_000 { return one_dec(ns, 1_000) + "µs" }
    if ns < 1_000_000_000 { return one_dec(ns, 1_000_000) + "ms" }
    s = ns / 1_000_000_000
    if s < 60 { return one_dec(ns, 1_000_000_000) + "s" }
    if s < 3600 {
        rest = s % 60
        if rest == 0 { return "#{s / 60}m" }
        return "#{s / 60}m#{rest}s"
    }
    mins = (s / 60) % 60
    if mins == 0 { return "#{s / 3600}h" }
    "#{s / 3600}h#{mins}m"
}

// n / unit，保留一位小数（截断），".0" 省掉
fn one_dec(n: int, unit: int) -> str {
    whole = n / unit
    tenth = (n % unit) * 10 / unit
    if tenth == 0 { "#{whole}" } else { "#{whole}.#{tenth}" }
}

// ---------- 日期 ----------

// 向下取整的除法和对应的余数（余数总是非负的），1970 年以前的时间要用
fn floor_div(a: int, b: int) -> int {
    q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn floor_mod(a: int, b: int) -> int { a - floor_div(a, b) * b }

pub fn date_utc(ms: int) -> Date {
    days = floor_div(ms, MS_PER_DAY)
    rest = floor_mod(ms, MS_PER_DAY)
    // 从 1970-01-01 起的天数换成年月日（Howard Hinnant 的 civil_from_days）
    z = days + 719_468
    era = floor_div(z, 146_097)
    doe = z - era * 146_097
    yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    d = doy - (153 * mp + 2) / 5 + 1
    m = if mp < 10 { mp + 3 } else { mp - 9 }
    y = if m <= 2 { yoe + era * 400 + 1 } else { yoe + era * 400 }
    Date(year: y, month: m, day: d, hour: rest / 3_600_000, minute: rest / 60_000 % 60, second: rest / 1000 % 60,
        ms: rest % 1000, weekday: floor_mod(days + 4, 7))
}

// 固定时差（分钟，东边为正）下的日期时间
pub fn date_at(ms: int, minutes: int) -> Date { date_utc(ms + minutes * 60_000) }

// 年月日换成从 1970-01-01 起的天数（days_from_civil）
fn days_from_civil(year: int, month: int, day: int) -> int {
    y = if month <= 2 { year - 1 } else { year }
    era = floor_div(y, 400)
    yoe = y - era * 400
    mp = if month > 2 { month - 3 } else { month + 9 }
    doy = (153 * mp + 2) / 5 + day - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146_097 + doe - 719_468
}

// Date 按 UTC 转回毫秒数；weekday 不参与计算
pub fn to_unix_ms(d: Date) -> int {
    days = days_from_civil(d.year, d.month, d.day)
    days * MS_PER_DAY + d.hour * 3_600_000 + d.minute * 60_000 + d.second * 1000 + d.ms
}

pub fn is_leap(year: int) -> bool { (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }

pub fn days_in_month(year: int, month: int) -> int {
    if month == 2 {
        feb = if is_leap(year) { 29 } else { 28 }
        return feb
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
}

fn pad(n: int, width: int) -> str {
    s = "#{n}"
    for len(s) < width { s = "0" + s }
    s
}

// 公元前（0 年以前）的年份写成 -0001 这样（ISO 8601 的扩展写法）
fn ymd(d: Date) -> str {
    y = if d.year < 0 { "-" + pad(0 - d.year, 4) } else { pad(d.year, 4) }
    "#{y}-#{pad(d.month, 2)}-#{pad(d.day, 2)}"
}

fn hms(d: Date) -> str { "#{pad(d.hour, 2)}:#{pad(d.minute, 2)}:#{pad(d.second, 2)}" }

// "2026-10-26 07:52:00"
pub fn format(d: Date) -> str { ymd(d) + " " + hms(d) }

// "2026-10-26T07:52:00.123Z"（d 应该是 date_utc 得到的）
pub fn format_iso(d: Date) -> str { ymd(d) + "T" + hms(d) + "." + pad(d.ms, 3) + "Z" }

// 带时差的 ISO 写法：format_iso_at(ms, 480) 是 "2026-10-29T12:24:01.123+08:00"，时差为 0 时写 Z
pub fn format_iso_at(ms: int, minutes: int) -> str {
    d = date_at(ms, minutes)
    ymd(d) + "T" + hms(d) + "." + pad(d.ms, 3) + offset_str(minutes)
}

fn offset_str(minutes: int) -> str {
    if minutes == 0 { return "Z" }
    sign = if minutes < 0 { "-" } else { "+" }
    m = if minutes < 0 { 0 - minutes } else { minutes }
    "#{sign}#{pad(m / 60, 2)}:#{pad(m % 60, 2)}"
}

// 系统时区（TZ 环境变量或者系统设置）在 ms 这一刻的时差，分钟，东边为正；夏令时会让同一个地方不同日子的时差不一样
pub fn local_offset(ms: int) -> int { lark_tz_offset(ms) }

// ---------- 解析 ----------

// 接受 "2026-10-26"、"2026-10-26T07:52:00Z"、"2026-10-26T07:52:00.123Z"（T 也可以写成空格，末尾的 Z 可以省略），
// 以及带时差的 "2026-10-26T15:52:00+08:00"（+0800、-05:00 也行），都换算成 UTC 的毫秒数。
// 年份至少 4 位，前面可以有 - 或 +（ISO 8601 的扩展写法）："-0002-12-17"、"10000-01-01"，format_iso 写出来的都能读回来
pub fn parse_iso(s: str) -> int! {
    n = len(s)
    bad = "时间格式不对：#{s}（应该像 2026-10-26T07:52:00Z）"
    sign = if n > 0 && (byte_at(s, 0) == '-' || byte_at(s, 0) == '+') { 1 } else { 0 }
    ye = sign
    for ye < n && ye - sign < 6 && byte_at(s, ye) >= '0' && byte_at(s, ye) <= '9' { ye += 1 }
    // b 是年份多出 4 位的部分：后面的位置都按 "2026-…" 的写法往后挪 b
    b = ye - 4
    if ye - sign < 4 || n < b + 10 || byte_at(s, b + 4) != '-' || byte_at(s, b + 7) != '-' { return Err(bad) }
    y0 = num(s, sign, ye)?
    y = if byte_at(s, 0) == '-' { 0 - y0 } else { y0 }
    mo = num(s, b + 5, b + 7)?
    dd = num(s, b + 8, b + 10)?
    if mo < 1 || mo > 12 || dd < 1 || dd > days_in_month(y, mo) { return Err("没有这一天：#{slice(s, 0, b + 10)}") }
    h = 0
    mi = 0
    sec = 0
    msv = 0
    off_min = 0
    i = b + 10
    if n > b + 10 {
        sep = byte_at(s, b + 10)
        if (sep != 'T' && sep != ' ') || n < b + 19 || byte_at(s, b + 13) != ':' || byte_at(s, b + 16) != ':' {
            return Err(bad)
        }
        h = num(s, b + 11, b + 13)?
        mi = num(s, b + 14, b + 16)?
        sec = num(s, b + 17, b + 19)?
        if h > 23 || mi > 59 || sec > 59 { return Err("时间不对：#{slice(s, b + 11, b + 19)}") }
        i = b + 19
        if i < n && byte_at(s, i) == '.' {
            if i + 4 > n { return Err("毫秒要写 3 位：#{s}") }
            msv = num(s, i + 1, i + 4)?
            i += 4
        }
        if i < n && byte_at(s, i) == 'Z' {
            i += 1
        } else if i < n && (byte_at(s, i) == '+' || byte_at(s, i) == '-') {
            // ±hh:mm 或 ±hhmm
            neg = byte_at(s, i) == '-'
            colon = i + 3 < n && byte_at(s, i + 3) == ':'
            e = if colon { i + 6 } else { i + 5 }
            if e > n { return Err("时差的格式不对：#{slice(s, i, n)}（应该像 +08:00）") }
            oh = num(s, i + 1, i + 3)?
            om = if colon { num(s, i + 4, i + 6)? } else { num(s, i + 3, i + 5)? }
            if oh > 23 || om > 59 { return Err("时差不对：#{slice(s, i, e)}") }
            off = oh * 60 + om
            off_min = if neg { 0 - off } else { off }
            i = e
        }
    }
    if i != n { return Err("时间后面有多余的内容：#{slice(s, i, n)}") }
    d = Date(year: y, month: mo, day: dd, hour: h, minute: mi, second: sec, ms: msv, weekday: 0)
    Ok(to_unix_ms(d) - off_min * 60_000)
}

// s[a..b] 必须全是数字
fn num(s: str, a: int, b: int) -> int! {
    for k in a..b {
        ch = byte_at(s, k)
        if ch < '0' || ch > '9' { return Err("这里应该是数字：#{slice(s, a, b)}") }
    }
    try_parse_int(slice(s, a, b))
}

// ---------- 读时长 ----------

// 读时长，得到纳秒数："300ms"、"1.5s"、"2m30s"、"1h"、"-10s"。单位是 ns、us（或 µs）、ms、s、m、h，
// 数可以带小数，几段可以连着写；"0" 可以不带单位。和 Go 的 time.ParseDuration 一样
pub fn parse_dur(s: str) -> int! {
    bad = "时长的写法不对：#{s}（应该像 300ms、1.5s、2m30s）"
    n = len(s)
    i = 0
    neg = false
    if i < n && (byte_at(s, i) == '-' || byte_at(s, i) == '+') {
        neg = byte_at(s, i) == '-'
        i += 1
    }
    if i == n { return Err(bad) }
    if slice(s, i, n) == "0" { return Ok(0) }
    total = 0
    for i < n {
        // 整数部分和小数部分
        whole = 0
        a = i
        for i < n && byte_at(s, i) >= '0' && byte_at(s, i) <= '9' {
            if whole > 100_000_000_000_000_000 { return Err("时长太大：#{s}") }
            whole = whole * 10 + (byte_at(s, i) - '0')
            i += 1
        }
        frac = 0
        scale = 1
        has_frac = false
        if i < n && byte_at(s, i) == '.' {
            i += 1
            has_frac = true
            for i < n && byte_at(s, i) >= '0' && byte_at(s, i) <= '9' {
                // 最多看 9 位小数，再多的丢掉（已经不到 1 纳秒）
                if scale < 1_000_000_000 {
                    frac = frac * 10 + (byte_at(s, i) - '0')
                    scale *= 10
                }
                i += 1
            }
        }
        if i == a || (has_frac && i == a + 1) { return Err(bad) }
        u = i
        for i < n && (byte_at(s, i) < '0' || byte_at(s, i) > '9') && byte_at(s, i) != '.' { i += 1 }
        unit = unit_ns(slice(s, u, i))
        if unit == 0 { return Err(if u == i { "时长少了单位：#{s}（可以用 ns us ms s m h）" } else { "不认识的时间单位 #{slice(s, u, i)}：#{s}" }) }
        if whole > 9_000_000_000_000_000_000 / unit { return Err("时长太大：#{s}") }
        // unit 和 scale 都是 10 的幂乘 1、60 或 3600，unit >= scale 时 unit / scale 是整数，不会溢出
        part = if unit >= scale { frac * (unit / scale) } else { frac * unit / scale }
        p = whole * unit + part
        // 每一段都不超出范围，几段加起来还可能超出
        if total > 9_000_000_000_000_000_000 - p { return Err("时长太大：#{s}") }
        total += p
    }
    Ok(if neg { 0 - total } else { total })
}

fn unit_ns(u: str) -> int {
    if u == "ns" { return 1 }
    if u == "us" || u == "µs" { return 1_000 }
    if u == "ms" { return 1_000_000 }
    if u == "s" { return 1_000_000_000 }
    if u == "m" { return 60_000_000_000 }
    if u == "h" { return 3_600_000_000_000 }
    0
}

// "#{d}"：2026-10-26 07:52:00.123（Date 不带时区：date_utc 得到的是 UTC，date_at 得到的是那个时差下的墙上时间）
pub fn show(d: Date) -> str { format(d) + "." + pad(d.ms, 3) }

// "#{t}"：Instant(123456789 ns)。单调时钟的读数，只有两个相减才有意义
pub fn show(t: Instant) -> str { "Instant(#{t.ns} ns)" }
