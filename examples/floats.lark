// 浮点数 float（需要 lark1 及以后的版本）
// 编译：lark1 examples/floats.lark -o out.c && cc -Iruntime out.c -o out -lm
import "std/math"
import "std/fmt"
import "std/sort"
import "std/json"

const G = 9.8
const HALF_G = G / 2.0

type Vec {
    x: float
    y: float
}

// 运算符重载照样能用：v + w 调用 add
fn add(a: Vec, b: Vec) -> Vec { Vec(x: a.x + b.x, y: a.y + b.y) }

fn show(v: Vec) -> str { "(#{v.x}, #{v.y})" }

fn norm(v: Vec) -> float { sqrt(v.x * v.x + v.y * v.y) }

// 牛顿法求平方根
fn newton(a: float) -> float {
    x = a
    for _i in 0..30 { x = (x + a / x) / 2.0 }
    x
}

fn mean(xs: [float]) -> float { math.sum(xs) / to_float(len(xs)) }

// 取对象的字段；没有时为 null
fn jfield(j: json.Json, k: str) -> json.Json {
    match json.get(j, k) {
        Some(v) => v.copy()
        None => json.Null
    }
}

fn main() {
    // 字面量与显示：能原样读回的最短写法，整数值也带 .0
    print("#{1.5} #{2.0} #{0.1} #{100.0} #{1e20} #{1.5e-7} #{1_000.25}")
    print("0.1 + 0.2 = #{0.1 + 0.2}")
    print("-0.5 * 3 = #{-0.5 * 3.0}，7 / 2 = #{7.0 / 2.0}，7.5 % 2 = #{7.5 % 2.0}")
    print("G = #{G}，G / 2 = #{HALF_G}")

    // 转换：int 和 float 不会自动转换
    n = 7
    print("to_float(7) / 2 = #{to_float(n) / 2.0}，to_int(-3.9) = #{to_int(-3.9)}")
    print("floor / ceil / round / trunc(-2.5)：#{floor(-2.5)} #{ceil(-2.5)} #{round(-2.5)} #{trunc(-2.5)}")
    print("float_str(0.25) = #{float_str(0.25)}，parse_float(\"3.75\") * 2 = #{parse_float("3.75") * 2.0}")
    match try_parse_float("abc") {
        Ok(v) => print("意外成功：#{v}")
        Err(e) => print("try_parse_float：#{e}")
    }

    // 数学
    print("sqrt(2) = #{sqrt(2.0)}，newton(2) 和它几乎相等：#{math.approx(newton(2.0), sqrt(2.0), 1e-15)}")
    print("PI = #{math.PI}，sin(PI / 2) = #{sin(math.PI / 2.0)}，ln(1) = #{ln(1.0)}，log10(1000) = #{log10(1000.0)}")
    print("2^0.5 = #{float_pow(2.0, 0.5)}，2^10 = #{math.pow(2, 10)}")
    print("abs / min / max / clamp：#{math.abs(-1.25)} #{math.min(0.5, -0.5)} #{math.max(0.5, -0.5)} #{math.clamp(1.5, 0.0, 1.0)}")

    // 特殊值：除以 0 不会 panic
    inf = 1.0 / 0.0
    nan = 0.0 / 0.0
    print("1 / 0 = #{inf}，-1 / 0 = #{-inf}，0 / 0 = #{nan}，nan == nan：#{nan == nan}")
    print("is_nan / is_inf / is_finite：#{math.is_nan(nan)} #{math.is_inf(math.INF)} #{math.is_finite(1.0)}")
    print("approx(0.1 + 0.2, 0.3)：#{math.approx(0.1 + 0.2, 0.3, 1e-12)}，0.1 + 0.2 == 0.3：#{0.1 + 0.2 == 0.3}")

    // 结构体、列表、排序、格式化
    v = Vec(x: 3.0, y: 0.5) + Vec(x: 0.0, y: 3.5)
    print("v = #{v}，|v| = #{norm(v)}")
    xs = [2.5, 3.5, 1.0, 5.0]
    print("xs = #{xs}，平均 #{mean(xs)}，最大 #{sort.max_of(xs)}，排序 #{sort.sorted(xs.copy())}")
    print("fixed：#{fmt.fixed(math.PI, 2)} #{fmt.fixed(-1.25, 1)} #{fmt.fixed(0.5, 0)}")
    total = 0.0
    for x in xs {
        if x > 2.0 { total += x }
    }
    print("大于 2 的和：#{total}")

    // JSON 里的小数：整数是 Num，带小数点或指数的是 Float
    text = "{\"pi\": 3.14, \"n\": -2, \"big\": 1e21, \"tiny\": -2.5E-3, \"huge\": 123456789012345678901}"
    match json.parse(text) {
        Ok(j) => {
            print(json.format(j))
            pi2 = (json.as_float(jfield(j, "pi")) ?? 0.0) * 2.0
            nf = json.as_float(jfield(j, "n")) ?? 0.0
            print("pi * 2 = #{pi2}，n 读成 float：#{nf}，n 读成 int：#{json.as_int(jfield(j, "n"))}")
        }
        Err(e) => print("解析失败：#{e}")
    }
    for b in ["1.", "2e", "-.5", "1e999"] {
        match json.parse(b) {
            Ok(y) => print("意外成功：#{y}")
            Err(e) => print("#{b} → #{e}")
        }
    }
    print(json.format(json.Arr([json.Float(0.1), json.Float(math.INF), json.Num(3)])))

    // 超出 int 范围的转换会 panic
    print("to_int(1e19)：")
    big = to_int(1e19)
    print("不会执行到这里 #{big}")
}
