// 泛型类型（需要 lark1 及以后的版本）
// 每组类型实参生成一份普通的结构体或枚举，和手写的没有区别。

type Pair[A, B] {
    a: A
    b: B
}

enum List[T] {
    Cons(head: T, tail: List[T])
    Nil
}

enum Tree[T] {
    Leaf(v: T)
    Node(l: Tree[T], r: Tree[T])
}

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    Pair(a: p.b.copy(), b: p.a.copy())
}

fn length[T](xs: List[T]) -> int {
    match xs {
        Cons(_, t) => 1 + length(t)
        Nil => 0
    }
}

fn from_list[T](xs: [T]) -> List[T] {
    out: List[T] = Nil
    i = len(xs) - 1
    for i >= 0 {
        out = Cons(xs[i].copy(), out)
        i -= 1
    }
    out
}

fn show_ints(xs: List[int]) -> str {
    match xs {
        Cons(h, t) => {
            rest = show_ints(t)
            if rest == "" { "#{h}" } else { "#{h} #{rest}" }
        }
        Nil => ""
    }
}

fn sum(t: Tree[int]) -> int {
    match t {
        Leaf(v) => v
        Node(l, r) => sum(l) + sum(r)
    }
}

fn depth[T](t: Tree[T]) -> int {
    match t {
        Leaf(_) => 1
        Node(l, r) => {
            dl = depth(l)
            dr = depth(r)
            m = if dl > dr { dl } else { dr }
            1 + m
        }
    }
}

fn main() {
    p = Pair(a: 1, b: "一")
    q = swap(p)
    print("交换后：(#{q.a}, #{q.b})")
    xs = Cons(1, Cons(2, Cons(3, Nil)))
    print("链表：#{show_ints(xs)}，长度 #{length(xs)}")
    ws = from_list(["甲", "乙"])
    print("字符串链表长度：#{length(ws)}")
    empty: List[str] = Nil
    print("空链表长度：#{length(empty)}")
    t = Node(Leaf(1), Node(Leaf(2), Leaf(3)))
    print("树：和 #{sum(t)}，深度 #{depth(t)}")
    ps: [Pair[str, int]] = [Pair(a: "x", b: 1), Pair(a: "y", b: 2)]
    for e in ps {
        print("#{e.a} = #{e.b}")
    }
}
